+/// guacamole: `M2V_TIGHT_RENDER_AREA=1` bounds a pass's render area by its draws (`end_pass`).
+fn tight_render_area() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("M2V_TIGHT_RENDER_AREA").is_ok_and(|v| v == "1"))
+}
+
+/// guacamole: with `M2V_TIGHT_RENDER_AREA_LOG=1`, the first 400 passes' render area decisions
+/// into /var/local/m2v-area.log.
+fn tight_render_area_log(line: impl FnOnce() -> String) {
+    use std::io::Write;
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    static LEFT: AtomicU32 = AtomicU32::new(0);
+    if !*ON.get_or_init(|| std::env::var("M2V_TIGHT_RENDER_AREA_LOG").is_ok_and(|v| v == "1")) {
+        return;
+    }
+    // a pass at most each second looks for /var/local/m2v-cache/area-go, which starts the next 400 lines
+    static CHECKED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs());
+    if CHECKED.swap(now, Ordering::Relaxed) != now && std::fs::remove_file("/var/local/m2v-cache/area-go").is_ok() {
+        LEFT.store(400, Ordering::Relaxed);
+    }
+    if LEFT.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_sub(1)).is_err() {
+        return;
+    }
+    if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true).open("/var/local/m2v-area.log") {
+        let _ = f.write_all(line().as_bytes());
+    }
+}
