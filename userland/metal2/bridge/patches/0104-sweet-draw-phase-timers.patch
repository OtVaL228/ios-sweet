+
+/// guacamole: `M2V_DRAW_PHASES=1` times `draw_resident`'s phases (the `_phases.mark(n)` lines: n is the phase that
+/// ends there; 14 runs to the end) and every 5000 draws appends each phase's mean per draw, in microseconds, to
+/// /var/local/m2v-cache/phases.log.
+struct DrawPhases {
+    on: bool,
+    last: u64,
+}
+
+static DRAW_PHASES: [std::sync::atomic::AtomicU64; 15] = [const { std::sync::atomic::AtomicU64::new(0) }; 15];
+static DRAW_PHASE_COUNT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn draw_phases_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("M2V_DRAW_PHASES").is_ok_and(|v| v == "1"))
+}
+
+unsafe extern "C" {
+    fn mach_absolute_time() -> u64;
+}
+
+#[inline]
+fn phase_ticks() -> u64 {
+    // SAFETY: libSystem's monotonic clock, 24 MHz ticks here (mach_timebase_info 125/3 ns).
+    unsafe { mach_absolute_time() }
+}
+
+static DRAW_PHASE_HITS: [std::sync::atomic::AtomicU64; 15] = [const { std::sync::atomic::AtomicU64::new(0) }; 15];
+
+impl DrawPhases {
+    #[inline]
+    fn begin() -> DrawPhases {
+        let on = draw_phases_on();
+        DrawPhases { on, last: if on { phase_ticks() } else { 0 } }
+    }
+
+    #[inline]
+    fn mark(&mut self, phase: usize) {
+        if self.on {
+            let now = phase_ticks();
+            DRAW_PHASES[phase].fetch_add(now.wrapping_sub(self.last), std::sync::atomic::Ordering::Relaxed);
+            DRAW_PHASE_HITS[phase].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            self.last = now;
+        }
+    }
+}
+
+impl Drop for DrawPhases {
+    fn drop(&mut self) {
+        if !self.on {
+            return;
+        }
+        self.mark(14);
+        let n = DRAW_PHASE_COUNT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+        if n % 5000 != 0 {
+            return;
+        }
+        let hz = 24_000_000.0f64; // mach_absolute_time's ticks (timebase 125/3 ns)
+        let mut line = format!("draws {n}:");
+        let mut total = 0.0;
+        for (i, p) in DRAW_PHASES.iter().enumerate() {
+            let us = p.swap(0, std::sync::atomic::Ordering::Relaxed) as f64 * 1e6 / hz / 5000.0;
+            total += us;
+            let hits = DRAW_PHASE_HITS[i].swap(0, std::sync::atomic::Ordering::Relaxed);
+            line += &format!(" {i}={us:.1}/{hits}");
+        }
+        line += &format!(" total={total:.1} us\n");
+        use std::io::Write;
+        if let Ok(mut f) =
+            std::fs::OpenOptions::new().append(true).create(true).open("/var/local/m2v-cache/phases.log")
+        {
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
