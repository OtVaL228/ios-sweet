 	gpu_fw_report();
 	printf("SWEET GPU: stage 1 done\n");
-	if (gpu_stage >= 2) {
-		gpu_stage2(gcc, gpucc);
+	if (gpu_stage >= 2 && gpu_stage2(gcc, gpucc) && gpu_stage >= 3) {
+		gpu_stage3();
