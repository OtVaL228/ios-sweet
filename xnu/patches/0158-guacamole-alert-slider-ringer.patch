+/* Position 0 top, 1 middle, 2 bottom; -1 while moving (no pin or two low). */
+static int
+slider_read(uint32_t *bits)
+{
+	int pos = -1, low = 0;
+	*bits = 0;
+	for (int i = 0; i < SLIDER_PINS; ++i) {
+		uint32_t v = keys_rd(slider_cfg[i], 4) & 1u;
+		*bits |= v << i;
+		if (!v) {
+			pos = i;
+			++low;
+		}
+	}
+	return low == 1 ? pos : -1;
+}
+
+/*
+ * Reports a stable position once after it changes (three equal reads,
+ * 60 ms), and keeps repeating the first one until a HID client (backboardd)
+ * is listening, so iOS starts with the real switch state.
+ */
+static void
+slider_poll(void)
+{
+	static int last = -2, count, sent = -2;
+	static unsigned retries;
+	uint32_t bits;
+	int pos = slider_read(&bits);
+	if (pos != last) {
+		last = pos;
+		count = 0;
+		return;
+	}
+	if (pos < 0 || ++count < 3 || pos == sent) {
+		return;
+	}
+	int silent = pos != 2;
+	if (slider_mode == 2) {
+		silent = !silent;
+	}
+	unsigned clients = sweet_hid_ringer(silent);
+	if (sent != -2 || clients || (retries++ % 250u) == 0) {
+		printf("SWEET KEYS: slider %s (pins %#x) -> %s, %u HID clients\n",
+		    pos == 0 ? "top" : pos == 1 ? "middle" : "bottom", bits,
+		    silent ? "silent" : "ring", clients);
+	}
+	if (clients) {
+		sent = pos;
+	}
+}
