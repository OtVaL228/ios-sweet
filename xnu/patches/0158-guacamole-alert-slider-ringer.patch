+/*
+ * Ring/silent switch: a level, not a press, on the Telephony page, usage 0x2E.
+ * backboardd takes ringerState = down and names 0 "silent", 1 "tone1", so the
+ * value is 1 while the switch is at ring. Returns the number of HID clients so
+ * the caller can repeat the initial state until backboardd listens.
+ */
+extern "C" unsigned
+sweet_hid_ringer(int silent)
+{
+	if (!gSweetButtons) {
+		return 0;
+	}
+	gSweetButtons->key(SWEET_HID_RINGER_SWITCH, silent == 0, kHIDPage_Telephony);
+	return gSweetButtons->clients();
+}
