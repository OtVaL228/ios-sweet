+/* A 16-bit little-endian FG value and its shadow copy, read until they agree. */
+bool
+SweetBattery::readShadow(unsigned address, unsigned copy, uint16_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi, lo2, hi2;
+		if (sweet_spmi_read(2, address, &lo) || sweet_spmi_read(2, address + 1, &hi) ||
+		    sweet_spmi_read(2, copy, &lo2) || sweet_spmi_read(2, copy + 1, &hi2)) {
+			return false;
+		}
+		if (lo == lo2 && hi == hi2) {
+			*value = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+			return true;
+		}
+	}
+	return false;
 }
 
 void
+SweetBattery::pollFuelGauge(void)
+{
+	uint8_t soc = 0, socCopy = 1, usb, path, charger, error, limits, tlo, thi;
+	uint16_t rawVoltage, rawCurrent;
+	for (unsigned attempt = 0; attempt < 4 && soc != socCopy; ++attempt) {
+		if (sweet_spmi_read(2, 0x4009, &soc) || sweet_spmi_read(2, 0x400a, &socCopy)) {
+			break;
+		}
+	}
+	bool valid = soc == socCopy && readShadow(0x41a0, 0x41a6, &rawVoltage) &&
+	    !sweet_spmi_read(2, 0x1310, &usb) &&
+	    !sweet_spmi_read(2, 0x110b, &path) &&
+	    !sweet_spmi_read(2, 0x1006, &charger) &&
+	    !sweet_spmi_read(2, 0x1007, &error) &&
+	    !sweet_spmi_read(2, 0x100d, &limits);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u) : 0;
+	valid = valid && mv >= 2800 && mv <= 4600;
+	fPolls++;
+	if (!valid) {
+		fTemperature = 2500;
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	/* fg_get_msoc(): 255 is full, 0 empty, 1..254 scaled to 1..99. */
+	unsigned percent = soc == 255 ? 100 : soc == 0 ? 0 : ((soc - 1u) * 98u + 126u) / 253u + 1u;
+	int ma = 0;
+	bool currentValid = readShadow(0x41a2, 0x41a8, &rawCurrent);
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* FG: positive = discharging; IOPMPowerSource: positive = charging. */
+		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+	}
+	fTemperature = 2500;
+	if (!sweet_spmi_read(2, 0x4150, &tlo) && !sweet_spmi_read(2, 0x4151, &thi)) {
+		int kelvin4 = (int)(((unsigned)(thi & 7u) << 8) | tlo);
+		int centi = kelvin4 * 25 - 27315;
+		if (centi >= 0 && centi <= 7000) {     /* below 0 C: left at 25 C */
+			fTemperature = (unsigned)centi;
+		}
+	}
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(limits & 0x0cu);
+	bool full = external && (state == 5 || percent == 100) && !(error & 2u);
+	publish(percent, mv, ma, external, capable, charging, full, true, currentValid);
+}
