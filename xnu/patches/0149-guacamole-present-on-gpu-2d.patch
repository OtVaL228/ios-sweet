+	    (md = IOMemoryDescriptor::withPhysicalAddress(pa, 0x10000, kIODirectionInOut)) == NULL ||
+	    (map = md->map(kIOMapWriteCombineCache)) == NULL ||
+	    !fbgpu_map_contig(sweet_fbgpu.win, pa, 0x10000) ||
+	    !fbgpu_map_contig(sweet_fbgpu.win + FBGPU_PANEL_OFF, panel_pa, round_page_64(panel_bytes))) {
+		IOLog("SWEET FB: GPU present unavailable: the CPU copies frames\n");
+		return false;
+	}
