+}
+
+static uint32_t
+fbgpu_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | cnt | (fbgpu_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (fbgpu_parity(reg) << 27);
+}
+
+static uint32_t
+fbgpu_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (fbgpu_parity(cnt) << 15) | ((op & 0x7fu) << 16) | (fbgpu_parity(op) << 23);
