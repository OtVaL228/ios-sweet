+/* Map n bytes of physically contiguous memory at iova */
+static bool
+fbgpu_map_contig(uint64_t iova, uint64_t pa, uint64_t bytes)
+{
+	for (uint64_t off = 0; off < bytes;) {
+		uint32_t n = 0;
+		uint64_t start = off;
+		for (; n < FBGPU_SLOT_BYTES / 4096 && off < bytes; n++, off += 4096) {
+			sweet_fbgpu.pages[n] = pa + off;
+		}
+		if (sweet_gpu_map_at(iova + start, sweet_fbgpu.pages, n)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Once: the window, the command buffers, the panel mapping */
+static bool
+fbgpu_setup(uint64_t panel_pa, uint64_t panel_bytes)
+{
+	if (sweet_fbgpu.tried) {
+		return sweet_fbgpu.ok;
+	}
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfbgpu", &on, sizeof(on));
+	if (!on || !redwood_gpu_ready()) {
+		if (!on) {
+			sweet_fbgpu.tried = true;
+		}
+		return false;
+	}
+	sweet_fbgpu.tried = true;
+	uint64_t pa = 0;
+	sweet_fbgpu.pages = IONew(uint64_t, FBGPU_SLOT_BYTES / 4096);
+	IOMemoryDescriptor *md = NULL;
+	IOMemoryMap *map = NULL;
