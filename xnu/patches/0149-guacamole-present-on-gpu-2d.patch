+/* 1 shown (queued on the GPU), 0 not for the GPU (the CPU path shows it), -1 the GPU is busy: next vsync */
+int
+AppleCLCD::presentGPU(const uint8_t *rec)
+{
+	if (!sweet_fb_metal || !fScaleUp || !fbgpu_setup(fPhys, (uint64_t)fRowBytes * fHeight)) {
+		return 0;
+	}
+	pauseConsole();
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS;
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			if (layer != SWEET_FB_LAYERS) {
+				return 0;               /* two layers: the CPU path composes them */
+			}
+			layer = l;
+		}
+	}
+	if (layer == SWEET_FB_LAYERS) {
+		return 0;
+	}
+	unsigned k = sweet_fbgpu.next;
+	if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+		return -1;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (s == NULL || s == fSurface || s->memory == NULL || s->pixelFormat != 0x42475241u ||
+	    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 || (s->bytesPerRow & 63) ||
+	    (s->offset & 63)) {
+		OSSafeReleaseNULL(s);
+		return 0;
+	}
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	const uint8_t *b = rec + 0xc4 + 16 * layer;
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+	int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0 || dx < 0 || dy < 0 || w > (int32_t)s->width - sx || h > (int32_t)s->height - sy ||
+	    w > (int32_t)fLogicalW - dx || h > (int32_t)fLogicalH - dy) {
+		OSSafeReleaseNULL(s);
+		return 0;
+	}
+	bool busy = false;
+	uint64_t src = fbgpu_surface_va(s, &busy);
+	uint32_t sw = s->width, sh = s->height, spitch = s->bytesPerRow;
+	src += src ? s->offset : 0;
+	s->release();
+	if (src == 0) {
+		return busy ? -1 : 0;
+	}
+	/* the panel rectangle the logical one covers (presentScaled's rounding) */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	px1 = px1 > fWidth ? fWidth : px1;
+	py1 = py1 > fHeight ? fHeight : py1;
+	if (px1 <= px0 || py1 <= py0) {
+		return 0;
+	}
+	uint64_t dst = sweet_fbgpu.win + FBGPU_PANEL_OFF;
+	uint64_t border = sweet_fbgpu.win + 2 * FBGPU_IB_BYTES, ts = border + 0x100;
+	uint32_t *dw = sweet_fbgpu.ib[k], n = 0;
+#define EV(e)           do { dw[n++] = fbgpu_pkt7(0x46, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)        do { dw[n++] = fbgpu_pkt7(0x46, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; \
+	                     dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)       do { dw[n++] = fbgpu_pkt4((r), 1); dw[n++] = (v); } while (0)
+	EV(0x31);                               /* CACHE_INVALIDATE */
+	REG(0xbb08, 0xfffff);                   /* SP_UPDATE_CNTL */
+	dw[n++] = fbgpu_pkt7(0x26, 0);          /* CP_WAIT_FOR_IDLE */
+	for (unsigned i = 0; i < sizeof(fbgpu_init) / sizeof(fbgpu_init[0]); i++) {
+		REG(fbgpu_init[i][0], fbgpu_init[i][1]);
+	}
+	dw[n++] = fbgpu_pkt4(0xb302, 2);        /* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = fbgpu_pkt4(0xb180, 2);        /* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	EV(0x19);                               /* PC_CCU_INVALIDATE_COLOR */
+	EV(0x31);
+	dw[n++] = fbgpu_pkt7(0x26, 0);
+	REG(0x8c01, 0);                         /* RB_A2D_PIXEL_CNTL: no blend */
+	REG(0x8c00, 0x00f03000);                /* RB_A2D_BLT_CNTL: 8888 UNORM, mask f */
+	REG(0x8400, 0x00f03000);                /* GRAS_A2D_BLT_CNTL */
+	REG(0xacc0, 0xf180);                    /* SP_A2D_OUTPUT_INFO */
+	dw[n++] = fbgpu_pkt4(0x8405, 2);        /* GRAS_A2D_DEST_TL, _BR (inclusive) */
+	dw[n++] = px0 | (py0 << 16);
+	dw[n++] = (px1 - 1) | ((py1 - 1) << 16);
+	dw[n++] = fbgpu_pkt4(0x8401, 4);        /* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+	dw[n++] = (uint32_t)sx << 8;
+	dw[n++] = (uint32_t)(sx + w - 1) << 8;
+	dw[n++] = (uint32_t)sy << 8;
+	dw[n++] = (uint32_t)(sy + h - 1) << 8;
+	dw[n++] = fbgpu_pkt4(0xb4c0, 5);        /* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+	dw[n++] = 0x00500430 | 0x10000;         /* 8888, linear, WXYZ; bilinear */
+	dw[n++] = sw | (sh << 15);
+	dw[n++] = (uint32_t)src;
+	dw[n++] = (uint32_t)(src >> 32);
+	dw[n++] = spitch << 3;
+	dw[n++] = fbgpu_pkt4(0xb4ca, 3);        /* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+	dw[n++] = (uint32_t)src;
+	dw[n++] = (uint32_t)(src >> 32);
+	dw[n++] = 0;
+	dw[n++] = fbgpu_pkt4(0x8c17, 4);        /* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)dst;
+	dw[n++] = (uint32_t)(dst >> 32);
+	dw[n++] = fRowBytes >> 6;
+	dw[n++] = fbgpu_pkt4(0x8c20, 3);        /* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+	dw[n++] = (uint32_t)dst;
+	dw[n++] = (uint32_t)(dst >> 32);
+	dw[n++] = 0;
+	dw[n++] = fbgpu_pkt7(0x2c, 1);          /* CP_BLIT */
+	dw[n++] = 3;                            /* BLIT_OP_SCALE */
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	EV_TS(0x1c);                            /* PC_CCU_FLUSH_DEPTH_TS */
+	EV_TS(0x04);                            /* CACHE_FLUSH_TS */
+#undef EV
+#undef EV_TS
+#undef REG
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t iova = sweet_fbgpu.win + (uint64_t)k * FBGPU_IB_BYTES;
+	uint32_t fence = sweet_gpu_submit_v2(&iova, &n, 1, &busy);
+	if (fence == 0) {
+		return busy ? -1 : 0;
+	}
+	sweet_fbgpu.fence[k] = fence;
+	sweet_fbgpu.next = k ^ 1;
+	static bool said;
+	if (!said) {
+		said = true;
+		IOLog("SWEET FB: first GPU present: %ux%u -> panel %u,%u-%u,%u (%u dwords, fence %u)\n", sw, sh,
+		    px0, py0, px1, py1, n, fence);
+	}
+	return 1;
+}
