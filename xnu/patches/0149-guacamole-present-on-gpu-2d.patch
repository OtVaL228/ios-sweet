+ * 0149: the present on the GPU's 2D engine (CP_BLIT, BLIT_OP_SCALE: bilinear scale of CoreAnimation's
+ * 1125x2436 surface onto the 1440x3120 panel), queued behind the frame's own drawing on the same ring.
+ * The CPU copy (present/presentScaled) took 21 ms a frame (mtl2 run 9: cache flush of 11 MB, nearest-
+ * neighbour scale, 18 MB into write-combined panel memory), more than a 60 Hz vsync. Register values:
+ * ios-flame's a6_blit_ib (NWylynko/ios-flame, MIT: turnip's r2d path for vkCmdBlitImage captured on the
+ * same A640), field layouts in Mesa's a6xx.xml. Only for one enabled BGRA layer with 64-byte rows while
+ * Metal draws (sweetmtl=2); anything else takes the CPU path. Boot-arg sweetfbgpu=0 keeps the CPU path.
+ *
+ * GPU VA: one 256 MB window of 0144's: +0 the command buffers and scratch (64 KB of the pool),
+ * +16 MB the panel memory, +64 MB four 16 MB slots for CoreAnimation's surfaces (it rotates three).
+ */
+#define FBGPU_IB_BYTES          0x4000u
+#define FBGPU_PANEL_OFF         0x1000000ull
+#define FBGPU_SLOT_OFF          0x4000000ull
+#define FBGPU_SLOT_BYTES        0x1000000ull
+#define FBGPU_SLOTS             4
+
+static struct {
+	bool tried, ok;
+	uint64_t win;
+	uint32_t *ib[2];                /* CPU view (write-combined) */
+	uint32_t fence[2];
+	unsigned next;
+	struct { uint32_t id; uint64_t pa0, len; } slot[FBGPU_SLOTS];
+	unsigned victim;
+	uint64_t *pages;                /* FBGPU_SLOT_BYTES / 4K */
