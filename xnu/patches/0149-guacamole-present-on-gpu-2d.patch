+}
+
+/*
+ * The slot holding this surface (mapped now if it is new): the GPU VA of its byte 0, or 0. A slot is
+ * remapped only while no blit of ours is queued (busy: *busy, the frame waits a vsync).
+ */
+static uint64_t
+fbgpu_surface_va(SweetSurface *s, bool *busy)
+{
+	IOByteCount seg = 0;
+	uint64_t len = round_page_64(s->memory->getLength());
+	uint64_t pa0 = s->memory->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+	if (pa0 == 0 || len > FBGPU_SLOT_BYTES) {
+		return 0;
+	}
+	for (unsigned i = 0; i < FBGPU_SLOTS; i++) {
+		if (sweet_fbgpu.slot[i].id == s->id && sweet_fbgpu.slot[i].pa0 == pa0 && sweet_fbgpu.slot[i].len == len) {
+			return sweet_fbgpu.win + FBGPU_SLOT_OFF + i * FBGPU_SLOT_BYTES;
+		}
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+			*busy = true;
+			return 0;
+		}
+	}
+	unsigned i = sweet_fbgpu.victim++ % FBGPU_SLOTS;
+	uint32_t n = 0;
+	for (uint64_t off = 0; off < len; off += 4096, n++) {
+		addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || (pa & 4095)) {
+			return 0;
+		}
+		sweet_fbgpu.pages[n] = pa;
+	}
+	uint64_t va = sweet_fbgpu.win + FBGPU_SLOT_OFF + i * FBGPU_SLOT_BYTES;
+	sweet_fbgpu.slot[i].id = 0;
+	if (sweet_gpu_map_at(va, sweet_fbgpu.pages, n)) {
+		return 0;
+	}
+	sweet_fbgpu.slot[i].id = s->id;
+	sweet_fbgpu.slot[i].pa0 = pa0;
+	sweet_fbgpu.slot[i].len = len;
+	return va;
+}
 
