--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -1075,6 +1075,18 @@
 		uint8_t limits[0x18] = { 0 };
 		put32(limits, 0x0, SWEET_SURFACE_ROW_ALIGN - 1);
 		put32(limits, 0x4, SWEET_SURFACE_ROW_ALIGN - 1);
+		/*
+		 * 0214: the maxima. IOSurface.framework (__iosConnectInitalize, research/iosurface/) keeps this block as
+		 * _ioSurfaceLimits and IOSurfaceGetPropertyMaximum answers BytesPerRow (+0x08), Width (+0x0c) and Height
+		 * (+0x10) from it as-is (their Plane* keys too). They were 0, so every size was over the maximum:
+		 * BaseBoard's +[IOSurface bs_IOSurfaceWithWidth:height:options:] returns nil when width or height exceeds
+		 * it, and PosterBoard snapshotted the wallpaper over no surface (black lock and home screens, every
+		 * poster). The values are what create() already enforces: SWEET_SURFACE_MAX_DIM a side, and the widest
+		 * row of that many 16-byte texels (an allocation over SWEET_SURFACE_MAX_ALLOC is still refused there).
+		 */
+		put32(limits, 0x8, SWEET_SURFACE_MAX_DIM * 16);
+		put32(limits, 0xc, SWEET_SURFACE_MAX_DIM);
+		put32(limits, 0x10, SWEET_SURFACE_MAX_DIM);
 		limits[0x16] = 1;
 		sweet_surf_log_once("sel", selector);
 		return sweet_struct_out(args, limits, sizeof(limits));
