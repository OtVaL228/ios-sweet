+int proc_selfpid(void);
+uint32_t sweet_mtl_pid_submits(int pid, uint32_t *last_fence);
+}
+
+/*
+ * 0169: the last GPU job each process queued, and how many it has queued. The display (SweetFramebuffer.cpp)
+ * reads it for the process that swaps (backboardd): which fence a frame's drawing ends at, and whether that
+ * drawing reached the ring before the swap. A small table; a pid not in it reads as no submits.
+ */
+#define SWEET_MTL_PIDS  16
+static struct {
+	int pid;
+	uint32_t fence, submits;
+} sweet_mtl_pid[SWEET_MTL_PIDS];
+static unsigned sweet_mtl_pid_next;
+
+static void
+sweet_mtl_note_submit(int pid, uint32_t fence)
+{
+	unsigned i;
+	for (i = 0; i < SWEET_MTL_PIDS; i++) {
+		if (sweet_mtl_pid[i].pid == pid) {
+			break;
+		}
+	}
+	if (i == SWEET_MTL_PIDS) {
+		/* a new process: take the oldest slot (two first submits at once may both land: harmless counts) */
+		i = __atomic_fetch_add(&sweet_mtl_pid_next, 1, __ATOMIC_RELAXED) % SWEET_MTL_PIDS;
+		__atomic_store_n(&sweet_mtl_pid[i].submits, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&sweet_mtl_pid[i].pid, pid, __ATOMIC_RELEASE);
+	}
+	__atomic_store_n(&sweet_mtl_pid[i].fence, fence, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&sweet_mtl_pid[i].submits, 1, __ATOMIC_RELEASE);
+}
+
+uint32_t
+sweet_mtl_pid_submits(int pid, uint32_t *last_fence)
+{
+	for (unsigned i = 0; i < SWEET_MTL_PIDS; i++) {
+		if (__atomic_load_n(&sweet_mtl_pid[i].pid, __ATOMIC_ACQUIRE) == pid) {
+			*last_fence = __atomic_load_n(&sweet_mtl_pid[i].fence, __ATOMIC_ACQUIRE);
+			return __atomic_load_n(&sweet_mtl_pid[i].submits, __ATOMIC_ACQUIRE);
+		}
+	}
+	*last_fence = 0;
+	return 0;
 }
 
 #define SWEET_V2_OPEN_TYPE      0x4147  /* the darwin backend's default ('AG', as the AGX plugin's) */
@@ -581,6 +627,7 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 			return busy ? kIOReturnBusy : kIOReturnNotReady;
 		}
 		fLastFence = fence;
+		sweet_mtl_note_submit(proc_selfpid(), fence);  /* 0169 */
 		rp->fence = fence;
 		return kIOReturnSuccess;
 	}
