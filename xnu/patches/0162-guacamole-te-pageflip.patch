+bool
+AppleCLCD::setupPageFlip(void)
+{
+	uint32_t requested = 0;
+	(void)PE_parse_boot_argn("sweetfb_pageflip", &requested, sizeof(requested));
+	if (!requested) {
+		return false;
+	}
+	if (!fHardwareVsync || fSde == 0 || fWidth != 1440 || fHeight != 3120 || fRowBytes != 5760) {
+		IOLog("SWEET FB: pageflip unavailable (requires hardware TE and 1440x3120x5760 panel)\n");
+		return false;
+	}
+	fPageFlipBytes = round_page_64((uint64_t)fRowBytes * fHeight);
+	fPageFlipActive = -1;
+	fPageFlipPending = -1;
+	fPageFlipCommits = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		fPageFlipPa[i] = 0;
+		fPageFlipPixels[i] = 0;
+		fPageFlipMemory[i] = NULL;
+		fPageFlipMap[i] = NULL;
+		if (sweet_gpu_pool_alloc(fPageFlipBytes, &fPageFlipPa[i]) != 0 || fPageFlipPa[i] > 0xffffffffull ||
+		    (fPageFlipMemory[i] = IOMemoryDescriptor::withPhysicalAddress(fPageFlipPa[i],
+		    (IOByteCount)fPageFlipBytes, kIODirectionInOut)) == NULL ||
+		    (fPageFlipMap[i] = fPageFlipMemory[i]->map(kIOMapWriteCombineCache)) == NULL) {
+			IOLog("SWEET FB: pageflip buffer %u allocation/map failed (pa=%llx)\n", i, fPageFlipPa[i]);
+			for (unsigned j = 0; j <= i; j++) {
+				OSSafeReleaseNULL(fPageFlipMap[j]);
+				OSSafeReleaseNULL(fPageFlipMemory[j]);
+				if (fPageFlipPa[j] != 0) {
+					sweet_gpu_pool_free(fPageFlipPa[j], fPageFlipBytes);
+					fPageFlipPa[j] = 0;
+				}
+			}
+			return false;
+		}
+		fPageFlipPixels[i] = (uintptr_t)fPageFlipMap[i]->getVirtualAddress();
+		if (fPageFlipPixels[i] == 0) {
+			IOLog("SWEET FB: pageflip buffer %u has no CPU mapping\n", i);
+			for (unsigned j = 0; j <= i; j++) {
+				OSSafeReleaseNULL(fPageFlipMap[j]);
+				OSSafeReleaseNULL(fPageFlipMemory[j]);
+				if (fPageFlipPa[j] != 0) {
+					sweet_gpu_pool_free(fPageFlipPa[j], fPageFlipBytes);
+					fPageFlipPa[j] = 0;
+				}
+			}
+			return false;
+		}
+		memcpy((void *)fPageFlipPixels[i], (const void *)fPixels, (size_t)fRowBytes * fHeight);
+	}
+	__builtin_arm_dsb(0xf);
+	fPageFlipEnabled = true;
+	IOLog("SWEET FB: pageflip enabled: CTL0 VIG0+VIG1 buffers %#llx/%#llx (%llu bytes), commit at hardware TE\n",
+	    fPageFlipPa[0], fPageFlipPa[1], fPageFlipBytes);
+	return true;
+}
 
+void
+AppleCLCD::commitPageFlip(void)
+{
+	if (!fPageFlipEnabled || fPageFlipPending < 0 || fSde == 0) {
+		return;
+	}
+	const int next = fPageFlipPending;
+	volatile uint32_t *vig0 = (volatile uint32_t *)(fSde + SWEET_SDE_VIG0 + SWEET_SDE_SSPP_SRC0_ADDR);
+	volatile uint32_t *vig1 = (volatile uint32_t *)(fSde + SWEET_SDE_VIG1 + SWEET_SDE_SSPP_SRC0_ADDR);
+	volatile uint32_t *flush = (volatile uint32_t *)(fSde + SWEET_SDE_CTL0 + SWEET_SDE_CTL_FLUSH);
+	volatile uint32_t *start = (volatile uint32_t *)(fSde + SWEET_SDE_CTL0 + SWEET_SDE_CTL_START);
+	*vig0 = (uint32_t)fPageFlipPa[next];
+	*vig1 = (uint32_t)fPageFlipPa[next];
+	__builtin_arm_dsb(0xf);
+	*flush = 0x3; /* CTL0 flush mask: VIG0 and VIG1 address shadow registers */
+	__builtin_arm_dsb(0xf);
+	*start = 1;  /* command-mode kickoff, from the panel TE worker */
+	__builtin_arm_dsb(0xf);
+	fPageFlipActive = next;
+	fPageFlipPending = -1;
+	if (++fPageFlipCommits == 1 || (fPageFlipCommits % 300) == 0) {
+		IOLog("SWEET FB: pageflip commit %llu buffer %u pa=%llx CTL0 flush=3 start=1\n",
+		    fPageFlipCommits, next, fPageFlipPa[next]);
+	}
+}
+
+void
+AppleCLCD::stagePageFlip(void)
+{
+	if (!fPageFlipEnabled) {
+		return;
+	}
+	int next = fPageFlipActive == 0 ? 1 : 0;
+	memcpy((void *)fPageFlipPixels[next], (const void *)fPixels, (size_t)fRowBytes * fHeight);
+	__builtin_arm_dsb(0xf);
+	fPageFlipPending = next;
+}
