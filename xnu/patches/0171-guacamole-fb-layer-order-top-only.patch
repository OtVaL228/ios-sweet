+/*
+ * 0171: are all 64 alpha samples of this layer's source rectangle 255? Each sampled row is cache-invalidated
+ * on its own (the GPU wrote it), not the whole surface.
+ */
+static bool
+sweet_fb_layer_opaque(SweetSurface *s, const uint8_t *a)
+{
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	uintptr_t src = s->kernelAddress();
+	if (sw <= 0 || sh <= 0) {
+		sw = (int32_t)s->width;
+		sh = (int32_t)s->height;
+	}
+	if (src == 0 || s->memory == NULL || s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    sx < 0 || sy < 0 || sx + sw > (int32_t)s->width || sy + sh > (int32_t)s->height ||
+	    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 > s->memory->getLength()) {
+		return false;
+	}
+	for (int32_t j = 0; j < 8; j++) {
+		uint64_t off = (uint64_t)s->offset + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * s->bytesPerRow + (uint64_t)sx * 4;
+		s->memory->performOperation(kIOMemoryIncoherentIOFlush, off, (uint64_t)sw * 4);
+		const uint32_t *row = (const uint32_t *)(src + off);
+		for (int32_t i = 0; i < 8; i++) {
+			if ((row[(sw * (2 * i + 1)) / 16] >> 24) != 255u) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
