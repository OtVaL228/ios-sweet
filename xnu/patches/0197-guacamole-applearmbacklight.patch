+#define SWEET_BL_MAX    65536u          /* IODisplayParameters brightness range (0 - max) */
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+/* IODisplayParameters = { brightness = { min, max, value } } */
+static OSDictionary *
+sweet_bl_parameters(uint64_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSNumber *min = OSNumber::withNumber(0ULL, 32);
+	OSNumber *max = OSNumber::withNumber((unsigned long long)SWEET_BL_MAX, 32);
+	OSNumber *now = OSNumber::withNumber(value, 32);
+	if (params != NULL && brightness != NULL && min != NULL && max != NULL && now != NULL) {
+		brightness->setObject("min", min);
+		brightness->setObject("max", max);
+		brightness->setObject("value", now);
+		params->setObject("brightness", brightness);
+	}
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(now);
+	OSSafeReleaseNULL(brightness);
+	return params;
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	uint32_t enabled = 1;
+	PE_parse_boot_argn("sweetbacklight", &enabled, sizeof(enabled));
+	if (!enabled) {
+		IOLog("SWEET BL: AppleARMBacklight off (sweetbacklight=0)\n");
+		return false;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName("backlight");
+	for (unsigned i = 0; i < sizeof(sweet_bl_adt) / sizeof(sweet_bl_adt[0]); i++) {
+		OSData *data = OSData::withBytes(sweet_bl_adt[i].bytes, sweet_bl_adt[i].length);
+		if (data != NULL) {
+			setProperty(sweet_bl_adt[i].key, data);
+			data->release();
+		}
+	}
+	setProperty("backlight-control", kOSBooleanTrue);
+	OSDictionary *params = sweet_bl_parameters(SWEET_BL_MAX / 2);
+	if (params != NULL) {
+		setProperty("IODisplayParameters", params);
+		params->release();
+	}
+	setProperty(kIOUserClientClassKey, "AppleARMBacklightUserClient");
+	registerService();
+	IOLog("SWEET BL: AppleARMBacklight registered (iPhone X backlight properties, backlight-control)\n");
+	return true;
+}
+
+static unsigned sweet_bl_said;          /* setProperties keys logged */
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	const OSSymbol *key;
+	while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		OSObject *value = dict->getObject(key);
+		OSNumber *number = OSDynamicCast(OSNumber, value);
+		if (sweet_bl_said < 80) {
+			sweet_bl_said++;
+			IOLog("SWEET BL: %s sets %s (%s) %llu\n", name, key->getCStringNoCopy(),
+			    value != NULL ? value->getMetaClass()->getClassName() : "null",
+			    number != NULL ? number->unsigned64BitValue() : 0ULL);
+		}
+		if (key->isEqualTo("IODisplayParameters")) {
+			/* { brightness = N } or { brightness = { value = N } }: the value, the range kept */
+			OSDictionary *sub = OSDynamicCast(OSDictionary, value);
+			OSObject *b = sub != NULL ? sub->getObject("brightness") : NULL;
+			OSNumber *n = OSDynamicCast(OSNumber, b);
+			if (n == NULL && OSDynamicCast(OSDictionary, b) != NULL) {
+				n = OSDynamicCast(OSNumber, OSDynamicCast(OSDictionary, b)->getObject("value"));
+			}
+			if (n != NULL) {
+				OSDictionary *params = sweet_bl_parameters(n->unsigned64BitValue());
+				if (params != NULL) {
+					setProperty("IODisplayParameters", params);
+					params->release();
+				}
+			}
+			continue;
+		}
+		if (value != NULL && !key->isEqualTo("backlight-control")) {
+			setProperty(key, value);        /* kept: readable back (ioreg, sweet-displayd) */
+		}
+	}
+	it->release();
+	return kIOReturnSuccess;
+}
