index 3786e6b67..000000000 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -190,6 +190,24 @@
 #define SWEET_SDE_TEAR_TE_DETECTED     (1U << 3)
 #define SWEET_SDE_IRQ                 115
 
+/* Read-only SM8150 SDE snapshot, opt-in with sweetfb_sde_dump=1. */
+static void
+sweet_fb_dump_sde(vm_offset_t sde)
+{
+	static const uint32_t ctl[] = { 0x2000, 0x2200, 0x2400, 0x2600, 0x2800, 0x2a00 };
+	static const uint32_t sspp[] = { 0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000 };
+	for (unsigned i = 0; i < sizeof(ctl) / sizeof(ctl[0]); i++) {
+		volatile uint32_t *r = (volatile uint32_t *)(sde + ctl[i]);
+		IOLog("SWEET FB: SDE CTL%u off=%x top=%x flush=%x start=%x intf_active=%x\n",
+		    i, ctl[i], r[0x14 / 4], r[0x18 / 4], r[0x1c / 4], r[0xf4 / 4]);
+	}
+	for (unsigned i = 0; i < sizeof(sspp) / sizeof(sspp[0]); i++) {
+		volatile uint32_t *r = (volatile uint32_t *)(sde + sspp[i]);
+		IOLog("SWEET FB: SDE SSPP%u off=%x src_size=%x src_xy=%x out_size=%x out_xy=%x addr0=%x addr1=%x stride=%x format=%x op=%x\n",
+		    i, sspp[i], r[0], r[2], r[3], r[4], r[5], r[6], r[9], r[12], r[14]);
+	}
+}
+
 void
 AppleCLCD::handleHardwareVsyncIrq(void)
 {
@@ -343,6 +361,13 @@
 		fSde = ml_io_map(SWEET_SDE_PA, SWEET_SDE_SIZE);
 		fHwVsyncCall = thread_call_allocate(&AppleCLCD::hwVsyncWorker, (thread_call_param_t)this);
 		if (fSde != 0 && fHwVsyncCall != NULL) {
+			uint32_t dumpSde = 0;
+			(void)PE_parse_boot_argn("sweetfb_sde_dump", &dumpSde, sizeof(dumpSde));
+			if (dumpSde != 0) {
+				IOLog("SWEET FB: SDE read-only snapshot begin\n");
+				sweet_fb_dump_sde(fSde);
+				IOLog("SWEET FB: SDE read-only snapshot end\n");
+			}
 			volatile uint32_t *intfStatus = (volatile uint32_t *)(fSde + SWEET_SDE_INTF1 + SWEET_SDE_INTF_INTR_STATUS);
 			volatile uint32_t *intfEnable = (volatile uint32_t *)(fSde + SWEET_SDE_INTF1 + SWEET_SDE_INTF_INTR_EN);
 			volatile uint32_t *intfClear = (volatile uint32_t *)(fSde + SWEET_SDE_INTF1 + SWEET_SDE_INTF_INTR_CLEAR);
