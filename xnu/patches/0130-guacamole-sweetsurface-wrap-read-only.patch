+/*
+ * 0130: wire [at, at + length) of task for a wrapped surface. Image data CoreAnimation got from
+ * a client is mapped read-only in backboardd, so wiring it for writing fails (gl13: every
+ * IOSurfaceAddress create "not wired"); then it is wired for reading only and *readOnly says
+ * so (the surface is mapped read-only everywhere).
+ */
+static IOMemoryDescriptor *
+sweet_wrap_range(task_t task, uint64_t at, uint64_t length, bool *readOnly)
+{
+	uint64_t first = trunc_page_64(at);
+	uint64_t size = round_page_64(at + length) - first;
+	IOReturn err = kIOReturnNoMemory;
+	for (int pass = 0; pass < 2; pass++) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(first, size,
+		    pass == 0 ? kIODirectionInOut : kIODirectionOut, task);
+		if (md == NULL) {
+			continue;
+		}
+		err = md->prepare(pass == 0 ? kIODirectionInOut : kIODirectionOut);
+		if (err == kIOReturnSuccess) {
+			*readOnly = pass == 1;
+			return md;
+		}
+		md->release();
+	}
+	IOLog("SWEET SURF: wrap %#llx (%llu bytes): not wired (%#x)\n", (unsigned long long)at,
+	    (unsigned long long)length, err);
+	return NULL;
+}
