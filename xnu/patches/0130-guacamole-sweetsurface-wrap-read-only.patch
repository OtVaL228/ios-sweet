+	bool readOnly = false;
+	IOMemoryDescriptor *md = sweet_wrap_range(fTask, address, size, &readOnly);
 	if (md == NULL) {
-		return kIOReturnNoMemory;
-	}
-	if (md->prepare() != kIOReturnSuccess) {
-		md->release();
 		return kIOReturnVMError;
 	}
 	SweetSurface *s = sweet_surface_alloc();
@@ -911,6 +940,7 @@ IOSurfaceRootUserClient::wrapClient(uint32_t selector, IOExternalMethodArguments
 	}
 	s->memory = md;
 	s->wrapped = true;
+	s->readOnly = readOnly;
