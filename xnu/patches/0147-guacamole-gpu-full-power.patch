+/*
+ * 0147: DDR (BCM "MC0") and the memory NoC ("SH0") voted to the top once the GPU runs, as ios-flame's
+ * 0122 (8-thread CPU bandwidth 13.7 -> 19 GB/s, its compositor ~20% faster there). Linux's msm driver
+ * votes the GPU's bandwidth through the interconnect framework (qcom/icc-bcm-voter.c, BCM_TCS_CMD:
+ * commit bit 30, valid bit 29, vote_x << 14, vote_y); nobody votes here, so DDR runs at whatever the
+ * boot left. Boot-arg sweetddr=0 leaves it so.
+ */
+static void
+gpu_ddr_vote(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	static const char *const bcm[] = { "MC0", "SH0" };
+	for (unsigned i = 0; i < 2; i++) {
+		const uint32_t offset = 0, vote = (1u << 30) | (1u << 29) | (0x3fffu << 14) | 0x3fffu;
+		int error = sweet_rpmh_write(bcm[i], 1, &offset, &vote);
+		printf("SWEET GPU: %s voted to the top: %d\n", bcm[i], error);
+	}
+}
