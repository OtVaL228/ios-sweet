+/*
+ * 0144: what the Turnip client (iokit/Kernel/arm/SweetAccelerator.cpp, the NativeAdreno ABI of
+ * UniXNU's darwin backend, as ios-flame 0115 has it) needs from the GPU core, on top of the
+ * functions above.
+ *
+ * GPU pool: Turnip's buffers are write-combined for the CPU and non-cacheable for the GPU. A WC
+ * view of RAM XNU manages would alias the physmap's cacheable mapping (ios-flame found CPU writes
+ * lost and reads stale that way), so they come from DDR XNU never maps: with --highmem XNU takes
+ * RAM from 4 GB up, and 0xC0000000-0xFFFFFFFF is plain RAM (Android's iomem) except what we use
+ * already: wland's radio pool at 0xE0000000 (16 MB kept) and the zap metadata at 0xF0000000.
+ * First fit over 64 KB chunks.
+ */
+extern void IOSleep(unsigned milliseconds);
+#define GPU_POOL_CHUNK    0x10000ull
+static const struct { uint64_t start, end; } gpu_pool_ranges[] = {
+	{ 0xc4000000ull, 0xe0000000ull },
+	{ 0xe1000000ull, 0xf0000000ull },
+};
+#define GPU_POOL_CHUNKS   ((0xe0000000ull - 0xc4000000ull + 0xf0000000ull - 0xe1000000ull) / GPU_POOL_CHUNK)
+static uint8_t gpu_pool_used[GPU_POOL_CHUNKS];
+static uint64_t gpu_pool_free_bytes = GPU_POOL_CHUNKS * GPU_POOL_CHUNK;
+
+static uint64_t
+gpu_pool_pa(uint64_t chunk)
+{
+	uint64_t first = (gpu_pool_ranges[0].end - gpu_pool_ranges[0].start) / GPU_POOL_CHUNK;
+	return chunk < first ? gpu_pool_ranges[0].start + chunk * GPU_POOL_CHUNK :
+	       gpu_pool_ranges[1].start + (chunk - first) * GPU_POOL_CHUNK;
+}
+
+int
+sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
+{
+	uint64_t need = (bytes + GPU_POOL_CHUNK - 1) / GPU_POOL_CHUNK, first = 0, run = 0;
+	if (need == 0) {
+		return EINVAL;
+	}
+	lck_mtx_lock(gpu_be_lock);
+	for (uint64_t c = 0; c < GPU_POOL_CHUNKS; c++) {
+		/* a buffer must not straddle the two ranges */
+		if (gpu_pool_used[c] || (run != 0 && gpu_pool_pa(c) != gpu_pool_pa(c - 1) + GPU_POOL_CHUNK)) {
+			run = 0;
+			if (gpu_pool_used[c]) {
+				continue;
+			}
+		}
+		if (run++ == 0) {
+			first = c;
+		}
+		if (run == need) {
+			memset(&gpu_pool_used[first], 1, need);
+			gpu_pool_free_bytes -= need * GPU_POOL_CHUNK;
+			lck_mtx_unlock(gpu_be_lock);
+			*pa = gpu_pool_pa(first);
+			return 0;
+		}
+	}
+	lck_mtx_unlock(gpu_be_lock);
+	return ENOMEM;
+}
+
+void
+sweet_gpu_pool_free(uint64_t pa, uint64_t bytes)
+{
+	uint64_t n = (bytes + GPU_POOL_CHUNK - 1) / GPU_POOL_CHUNK;
+	lck_mtx_lock(gpu_be_lock);
+	for (uint64_t c = 0; c < GPU_POOL_CHUNKS && n; c++) {
+		if (gpu_pool_pa(c) == pa) {
+			for (; n && c < GPU_POOL_CHUNKS; n--, c++) {
+				gpu_pool_used[c] = 0;
+				gpu_pool_free_bytes += GPU_POOL_CHUNK;
+			}
+			break;
+		}
+	}
+	lck_mtx_unlock(gpu_be_lock);
+}
+
+uint64_t
+sweet_gpu_pool_avail(void)
+{
+	return gpu_pool_free_bytes;
+}
+
+/*
+ * A client's GPU VA window (the client picks addresses inside it): 256 MB slots in
+ * [GVA_WIN_START, GVA_USER_END), apart from RedwoodGPU's allocator (its own lock) below.
+ */
+#define GVA_WIN_SLOT      0x10000000ull
+#define GVA_WIN_SLOTS     ((GVA_USER_END - GVA_WIN_START) / GVA_WIN_SLOT)
+static uint8_t gva_win_used[GVA_WIN_SLOTS];
+
+int
+sweet_gpu_window_alloc(uint64_t bytes, uint64_t *base)
+{
+	uint64_t need = (bytes + GVA_WIN_SLOT - 1) / GVA_WIN_SLOT;
+	lck_mtx_lock(gpu_be_lock);
+	for (uint64_t i = 0; need && i + need <= GVA_WIN_SLOTS; i++) {
+		uint64_t k = 0;
+		while (k < need && !gva_win_used[i + k]) {
+			k++;
+		}
+		if (k == need) {
+			memset(&gva_win_used[i], 1, need);
+			lck_mtx_unlock(gpu_be_lock);
+			*base = GVA_WIN_START + i * GVA_WIN_SLOT;
+			return 0;
+		}
+	}
+	lck_mtx_unlock(gpu_be_lock);
+	return ENOMEM;
+}
+
+void
+sweet_gpu_window_free(uint64_t base, uint64_t bytes)
+{
+	lck_mtx_lock(gpu_be_lock);
+	redwood_gpu_unmap(base, bytes);
+	for (uint64_t i = (base - GVA_WIN_START) / GVA_WIN_SLOT, n = (bytes + GVA_WIN_SLOT - 1) / GVA_WIN_SLOT;
+	    n && i < GVA_WIN_SLOTS; i++, n--) {
+		gva_win_used[i] = 0;
+	}
+	lck_mtx_unlock(gpu_be_lock);
+}
+
+/* 4K pages at a given GPU address (non-cacheable for the GPU, read-write) */
+int
+sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages)
+{
+	lck_mtx_lock(gpu_be_lock);
+	for (uint32_t i = 0; i < npages; i++) {
+		if (!redwood_gpu_map(iova + 4096ull * i, pages[i], false)) {
+			lck_mtx_unlock(gpu_be_lock);
+			return ENOMEM;
+		}
+	}
+	redwood_gpu_mapped();
+	lck_mtx_unlock(gpu_be_lock);
+	return 0;
+}
+
+void
+sweet_gpu_unmap_at(uint64_t iova, uint64_t bytes)
+{
+	lck_mtx_lock(gpu_be_lock);
+	redwood_gpu_unmap(iova, bytes);
+	lck_mtx_unlock(gpu_be_lock);
+}
+
+/*
+ * Up to 16 IBs as one job, wrapped like msm's a6xx_submit: the CCU (colour and depth) invalidated
+ * first, the fence written by CACHE_FLUSH_TS (redwood_gpu_submit's tail). 0 = not queued (*busy:
+ * the ring is full, try again).
+ */
+uint32_t
+sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
+{
+	*busy = false;
+	if (!be_ready || n == 0 || n > 16) {
+		return 0;
+	}
+	uint32_t need = 4u * n + 5u + 4u;
+	lck_mtx_lock(gpu_be_lock);
+	if (be_ring_free() < need) {
+		lck_mtx_unlock(gpu_be_lock);
+		*busy = true;
+		return 0;
+	}
+	be_emit(pkt7(70, 1));
+	be_emit(24u);                                   /* PC_CCU_INVALIDATE_DEPTH */
+	be_emit(pkt7(70, 1));
+	be_emit(25u);                                   /* PC_CCU_INVALIDATE_COLOR */
+	for (unsigned i = 0; i < n; i++) {
+		be_emit(pkt7(63, 3));                   /* CP_INDIRECT_BUFFER */
+		be_emit((uint32_t)iova[i]);
+		be_emit((uint32_t)(iova[i] >> 32));
+		be_emit(dwords[i]);
+	}
+	if (++be_seqno == 0) {
+		be_seqno = 1;
+	}
+	uint32_t fence = be_seqno;
+	be_emit(pkt7(70, 4));
+	be_emit(0x4u | 0x80000000u);                   /* CACHE_FLUSH_TS | IRQ */
+	be_emit((uint32_t)GVA_FENCEMEM);
+	be_emit((uint32_t)(GVA_FENCEMEM >> 32));
+	be_emit(fence);
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr((vm_offset_t)be_gpu, 0x807, be_wptr % RB_DWORDS);
+	lck_mtx_unlock(gpu_be_lock);
+	return fence;
+}
+
+/* 0 when the fence has passed; ETIMEDOUT after timeout_ns (0: just look) */
+int
+sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	for (unsigned spin = 0;; spin++) {
+		if (redwood_gpu_done(fence)) {
+			return 0;
+		}
+		if (timeout_ns == 0 || mach_absolute_time() >= deadline) {
+			return ETIMEDOUT;
+		}
+		if (spin < 64) {
+			delay(20);                      /* most fences pass within a frame: look often first */
+		} else {
+			IOSleep(1);
+		}
+	}
+}
+
+uint64_t
+sweet_gpu_timestamp(void)
+{
+	uint64_t t = 0;
+	redwood_gpu_parameter(0x05, &t);
+	return t;
+}
