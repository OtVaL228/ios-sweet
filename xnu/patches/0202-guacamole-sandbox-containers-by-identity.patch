+/* 0202: op 0xd, { identity, path, kind, persona }: signing identities only (kind 0), the last path wins */
+static int
+sweet_sandbox_container_for_identity(struct proc *p, user_addr_t arg)
+{
+	uint64_t args[4];
+	char ident[128], path[192];
+	size_t done = 0;
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		error = copyinstr((user_addr_t)args[0], ident, sizeof(ident), &done);
+	}
+	if (error == 0) {
+		error = copyinstr((user_addr_t)args[1], path, sizeof(path), &done);
+	}
+	if (error) {
+		return error == ENAMETOOLONG ? 0 : error;   /* too long to keep: accepted, not kept */
+	}
+	if (args[2] != 0 || ident[0] == '\0' || path[0] != '/') {
+		return 0;                       /* app groups: not asked for here */
+	}
+	int said = 0, added = 0;
+	lck_mtx_lock(&sweet_containers_lock);
+	unsigned i;
+	for (i = 0; i < sweet_ident_count; i++) {
+		if (strcmp(sweet_ident_containers[i].ident, ident) == 0) {
+			break;
+		}
+	}
+	if (i == sweet_ident_count && sweet_ident_count < SWEET_IDENT_CONTAINERS) {
+		sweet_ident_count++;
+		added = 1;
+	}
+	if (i < sweet_ident_count) {
+		strlcpy(sweet_ident_containers[i].ident, ident, sizeof(sweet_ident_containers[i].ident));
+		strlcpy(sweet_ident_containers[i].path, path, sizeof(sweet_ident_containers[i].path));
+	}
+	if (added && sweet_ident_said < 12) {
+		sweet_ident_said++;
+		said = 1;
+	}
+	unsigned count = sweet_ident_count;
+	lck_mtx_unlock(&sweet_containers_lock);
+	if (said) {
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s: container of %s is %s (%u known)\n", name, ident, path, count);
+	}
+	return 0;
+}
