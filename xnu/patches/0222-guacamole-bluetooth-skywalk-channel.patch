+static errno_t
+sweet_bt_channel_open(void)
+{
+	errno_t e;
+	if (sweet_bt_ncd == NULL) {
+		uuid_t dom;
+		nexus_attr_t nxa = NULL;
+		struct kern_nexus_provider_init prov = {
+			.nxpi_version = KERN_NEXUS_DOMAIN_PROVIDER_CURRENT_VERSION,
+			.nxpi_flags = NXPIF_VIRTUAL_DEVICE,
+			.nxpi_pre_connect = sweet_bt_pre_connect,
+			.nxpi_connected = sweet_bt_connected,
+			.nxpi_pre_disconnect = sweet_bt_pre_disconnect,
+			.nxpi_disconnected = sweet_bt_disconnected,
+			.nxpi_ring_init = sweet_bt_ring_init,
+			.nxpi_ring_fini = sweet_bt_ring_fini,
+			.nxpi_sync_tx = sweet_bt_sync_tx,
+			.nxpi_sync_rx = sweet_bt_sync_rx,
+		};
+		if ((e = kern_nexus_controller_create(&sweet_bt_ncd)) != 0) {
+			sweet_bt_ncd = NULL;
+			return e;
+		}
+		if ((e = kern_nexus_get_default_domain_provider(NEXUS_TYPE_KERNEL_PIPE, &dom)) != 0 ||
+		    (e = kern_nexus_attr_create(&nxa)) != 0) {
+			return e;
+		}
+		kern_nexus_attr_set(nxa, NEXUS_ATTR_SLOT_BUF_SIZE, SWEET_BT_SLOT_SIZE);
+		kern_nexus_attr_set(nxa, NEXUS_ATTR_TX_SLOTS, SWEET_BT_RING_SLOTS);
+		kern_nexus_attr_set(nxa, NEXUS_ATTR_RX_SLOTS, SWEET_BT_RING_SLOTS);
+		e = kern_nexus_controller_register_provider(sweet_bt_ncd, dom, (const uint8_t *)"com.sweet.nexus.bt.kpipe",
+		    &prov, sizeof(prov), nxa, &sweet_bt_prov_uuid);
+		kern_nexus_attr_destroy(nxa);
+		if (e != 0) {
+			kern_nexus_controller_destroy(sweet_bt_ncd);
+			sweet_bt_ncd = NULL;
+			return e;
+		}
+	}
+	if (sweet_bt_chan) {
+		return 0;
+	}
+	struct kern_pbufpool_init ppi;
+	bzero(&ppi, sizeof(ppi));
+	ppi.kbi_version = KERN_PBUFPOOL_CURRENT_VERSION;
+	ppi.kbi_flags = KBIF_VIRTUAL_DEVICE | KBIF_QUANTUM;
+	ppi.kbi_packets = SWEET_BT_RING_SLOTS * 4;
+	ppi.kbi_bufsize = SWEET_BT_SLOT_SIZE;
+	ppi.kbi_buf_seg_size = skmem_usr_buf_seg_size;
+	ppi.kbi_max_frags = 1;
+	(void) snprintf((char *)ppi.kbi_name, sizeof(ppi.kbi_name), "com.sweet.kpipe.bt");
+	if ((e = kern_pbufpool_create(&ppi, &sweet_bt_pp, NULL)) != 0) {
+		sweet_bt_pp = NULL;
+		return e;
+	}
+	struct kern_nexus_init init;
+	bzero(&init, sizeof(init));
+	init.nxi_version = KERN_NEXUS_CURRENT_VERSION;
+	init.nxi_tx_pbufpool = sweet_bt_pp;
+	if ((e = kern_nexus_controller_alloc_provider_instance(sweet_bt_ncd, sweet_bt_prov_uuid, NULL, NULL,
+	    &sweet_bt_inst_uuid, &init)) != 0) {
+		kern_pbufpool_destroy(sweet_bt_pp);
+		sweet_bt_pp = NULL;
+		return e;
+	}
+	nexus_port_t port = NEXUS_PORT_KERNEL_PIPE_CLIENT;
+	if ((e = kern_nexus_controller_bind_provider_instance(sweet_bt_ncd, sweet_bt_inst_uuid, &port, proc_selfpid(),
+	    NULL, NULL, 0, NEXUS_BIND_PID)) != 0) {
+		kern_nexus_controller_free_provider_instance(sweet_bt_ncd, sweet_bt_inst_uuid);
+		uuid_clear(sweet_bt_inst_uuid);
+		kern_pbufpool_destroy(sweet_bt_pp);
+		sweet_bt_pp = NULL;
+		return e;
+	}
+	lck_mtx_lock(&sweet_bt_lock);
+	sweet_bt_pend_head = sweet_bt_pend_len = 0;
+	sweet_bt_chan = true;
+	lck_mtx_unlock(&sweet_bt_lock);
+	printf("SWEET BT: channel open for pid %d\n", proc_selfpid());
+	return 0;
+}
+
+static void
+sweet_bt_channel_close(void)
+{
+	lck_mtx_lock(&sweet_bt_lock);
+	bool was = sweet_bt_chan;
+	sweet_bt_chan = false;
+	lck_mtx_unlock(&sweet_bt_lock);
+	if (!was) {
+		return;
+	}
+	if (kern_nexus_controller_free_provider_instance(sweet_bt_ncd, sweet_bt_inst_uuid) == 0 && sweet_bt_pp != NULL) {
+		kern_pbufpool_destroy(sweet_bt_pp);
+		sweet_bt_pp = NULL;
+	}
+	uuid_clear(sweet_bt_inst_uuid);
+	printf("SWEET BT: channel closed\n");
+}
+
 /* bytes from one side to the other's socket (dropped, and counted, when the other side is not there) */
+static void
+sweet_bt_to_bridge(const void *buf, size_t n)
+{
+	lck_mtx_lock(&sweet_bt_lock);
+	kern_ctl_ref ref = sweet_bt_host_ref;
+	u_int32_t unit = sweet_bt_host_unit;
+	lck_mtx_unlock(&sweet_bt_lock);
+	if (unit == 0 || ctl_enqueuedata(ref, unit, (void *)(uintptr_t)buf, n, 0) != 0) {
+		sweet_bt_lost += n;
+	} else {
+		sweet_bt_to_host += n;
+	}
+}
+
+/* bridge -> bluetoothd's channel (0222): queued, then the channel is told to read */
+static void
+sweet_bt_to_channel(const uint8_t *buf, size_t n)
+{
+	lck_mtx_lock(&sweet_bt_lock);
+	size_t room = SWEET_BT_PENDING - sweet_bt_pend_len, k = MIN(n, room);
+	for (size_t i = 0; i < k; i++) {
+		sweet_bt_pending[(sweet_bt_pend_head + sweet_bt_pend_len + i) % SWEET_BT_PENDING] = buf[i];
+	}
+	sweet_bt_pend_len += k;
+	sweet_bt_lost += n - k;
+	sweet_bt_to_ios += k;
+	kern_channel_ring_t rx = sweet_bt_rxring;
+	lck_mtx_unlock(&sweet_bt_lock);
+	if (rx != NULL) {
+		kern_channel_notify(rx, 0);
+	}
+}
