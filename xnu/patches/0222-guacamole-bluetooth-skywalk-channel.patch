+/* bluetoothd wrote: every filled slot's bytes go to the bridge */
+static errno_t
+sweet_bt_sync_tx(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, kern_channel_ring_t tx_ring,
+    __unused uint32_t flags)
+{
+	kern_channel_slot_t pslot = NULL, slot = kern_channel_get_next_slot(tx_ring, NULL, NULL);
+	struct kern_channel_ring_stat_increment stats = {};
+	while (slot != NULL) {
+		kern_packet_t ph = kern_channel_slot_get_packet(tx_ring, slot);
+		pslot = slot;
+		slot = kern_channel_get_next_slot(tx_ring, slot, NULL);
+		if (ph == 0) {
+			continue;
+		}
+		kern_buflet_t buf = kern_packet_get_next_buflet(ph, NULL);
+		if (buf == NULL) {
+			continue;
+		}
+		uint8_t *addr = (uint8_t *)kern_buflet_get_data_address(buf);
+		if (addr == NULL) {
+			continue;
+		}
+		addr += kern_buflet_get_data_offset(buf);
+		size_t len = MIN(kern_packet_get_data_length(ph), SWEET_BT_SLOT_SIZE);
+		sweet_bt_to_bridge(addr, len);
+		stats.kcrsi_slots_transferred++;
+		stats.kcrsi_bytes_transferred += len;
+	}
+	if (pslot != NULL) {
+		kern_channel_advance_slot(tx_ring, pslot);
+		kern_channel_increment_ring_stats(tx_ring, &stats);
+		(void) kern_channel_reclaim(tx_ring);
+	}
+	return 0;
+}
+
+/* bluetoothd reads: pending bridge bytes into free slots, up to a slot's size each */
+static errno_t
+sweet_bt_sync_rx(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, kern_channel_ring_t rx_ring,
+    __unused uint32_t flags)
+{
+	struct kern_channel_ring_stat_increment stats = {};
+	(void) kern_channel_reclaim(rx_ring);
+	if (kern_channel_available_slot_count(rx_ring) == 0) {
+		return 0;
+	}
+	struct kern_pbufpool *pp = rx_ring->ckr_pp;
+	kern_channel_slot_t pslot = NULL, slot = kern_channel_get_next_slot(rx_ring, NULL, NULL);
+	while (slot != NULL) {
+		kern_packet_t ph = 0;
+		if (sweet_bt_pend_len == 0 || kern_pbufpool_alloc_nosleep(pp, 1, &ph) != 0) {
+			break;
+		}
+		kern_buflet_t buf = kern_packet_get_next_buflet(ph, NULL);
+		uint8_t *addr = buf ? (uint8_t *)kern_buflet_get_data_address(buf) : NULL;
+		if (addr == NULL) {
+			kern_pbufpool_free(pp, ph);
+			break;
+		}
+		size_t n = 0;
+		lck_mtx_lock(&sweet_bt_lock);
+		while (n < SWEET_BT_SLOT_SIZE && n < PP_BUF_SIZE_DEF(pp) && sweet_bt_pend_len > 0) {
+			size_t run = MIN(MIN(sweet_bt_pend_len, SWEET_BT_PENDING - sweet_bt_pend_head),
+			    MIN((size_t)SWEET_BT_SLOT_SIZE, (size_t)PP_BUF_SIZE_DEF(pp)) - n);
+			memcpy(addr + n, sweet_bt_pending + sweet_bt_pend_head, run);
+			n += run;
+			sweet_bt_pend_head = (sweet_bt_pend_head + run) % SWEET_BT_PENDING;
+			sweet_bt_pend_len -= run;
+		}
+		lck_mtx_unlock(&sweet_bt_lock);
+		kern_buflet_set_data_offset(buf, 0);
+		kern_buflet_set_data_length(buf, (uint32_t)n);
+		kern_packet_finalize(ph);
+		if (kern_channel_slot_attach_packet(rx_ring, slot, ph) != 0) {
+			kern_pbufpool_free(pp, ph);
+			break;
+		}
+		stats.kcrsi_slots_transferred++;
+		stats.kcrsi_bytes_transferred += n;
+		pslot = slot;
+		slot = kern_channel_get_next_slot(rx_ring, slot, NULL);
+	}
+	if (pslot != NULL) {
+		kern_channel_advance_slot(rx_ring, pslot);
+		kern_channel_increment_ring_stats(rx_ring, &stats);
+	}
+	return 0;
+}
