+	flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(g, 0x808, 1);                                 /* CP_SQE_CNTL: start */
+	delay(1000);
+	gwr(g, 0x807, w);
