+	    n, done + 1, last);
+	gwr(g, 0x808, 3);                                 /* CP_SQE_CNTL: halt the SQE (msm a6xx_recover) */
+	/* msm a6xx_bus_clear_pending_transactions(gx_off = true) */
+	gwr(g, 0x0016, 1);                                /* RBBM_GBIF_HALT */
+	bool h0 = be_wait_reg(g, 0x0017, 1u, 10000);      /* RBBM_GBIF_HALT_ACK */
+	gwr(g, 0x3c45, 1u);                               /* GBIF_HALT: client requests */
+	bool h1 = be_wait_reg(g, 0x3c46, 1u, 10000);      /* GBIF_HALT_ACK */
+	gwr(g, 0x3c45, 2u);                               /* GBIF_HALT: AXI arbiter */
+	bool h2 = be_wait_reg(g, 0x3c46, 2u, 10000);
+	gwr(g, 0x3c45, 0);
