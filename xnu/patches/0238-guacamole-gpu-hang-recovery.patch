+/*
+ * 0238: GPU hang recovery. A job whose shader never ends (Subway Surfers' daily wheel, 0179 report) kept the CP in
+ * its IB forever: every later fence waited on it and the phone froze until reboot; killing the game did not help.
+ * When a fence waiter (thread context, not the display path) sees the done fence stuck for sweetgpurecoverms
+ * (default 3000, 0 = off) with jobs queued, the GPU core is reset and restarted, as msm's a6xx_recover /
+ * a6xx_gmu_force_off do it short of the power collapse: halt the SQE, clear GBIF's pending transactions, assert
+ * RBBM_SW_RESET_CMD >= 100 us, hw_init's registers again, SQE start + CP_ME_INIT, zap shader resume (SCM
+ * BOOT_SET_REMOTE_STATE(0, 0), msm's path after the first load), CP_SET_SECURE_MODE(0). The ring restarts empty
+ * at 0. The stuck job and every job queued behind it are dropped: the fence page gets the last queued fence, so
+ * their waiters return (their pictures are whatever was drawn). If the restart fails, the backend stops taking
+ * work (submits return 0: clients fail instead of the phone freezing) and the display falls back to the CPU.
+ * GMU, SMMU, page tables and GPU memory are not touched.
+ */
+static uint32_t sweet_gpu_recover_ms = 0xffffffffu;   /* not read yet */
+static uint32_t sweet_gpu_recoveries;
+static vm_offset_t sweet_gpu_recover_gmu;
+
+static bool
+be_ring_run(vm_offset_t g, unsigned w, unsigned ms_max)
+{
+	for (unsigned ms = 0; ms < ms_max; ++ms) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+		if (*(volatile uint32_t *)(gpumem + GPUMEM_SHADOW) == w) {
+			return true;
+		}
+		if (grd(g, 0x823) || grd(g, 0x821)) {
+			return false;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static bool
+be_wait_reg(vm_offset_t g, uint32_t reg, uint32_t mask, unsigned us)
+{
+	for (unsigned t = 0; t < us; t += 10) {
+		if ((grd(g, reg) & mask) == mask) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+/* gpu_be_lock held */
+static bool
+sweet_gpu_recover_locked(uint32_t done, uint32_t last)
+{
+	vm_offset_t g = (vm_offset_t)be_gpu;
+	if (sweet_gpu_recover_gmu == 0) {
+		sweet_gpu_recover_gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	}
+	if (g == 0 || sweet_gpu_recover_gmu == 0) {
+		return false;
+	}
