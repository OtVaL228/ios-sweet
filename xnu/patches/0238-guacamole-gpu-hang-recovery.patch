+	printf("SWEET GPU: RECOVER #%u: CP_ME_INIT %s (shadow %#x want %#x, CP_INT %#x HW_FAULT %#x)\n", n,
+	    ok ? "ran" : "FAILED", *(volatile uint32_t *)(gpumem + GPUMEM_SHADOW), w, grd(g, 0x823), grd(g, 0x821));
+	if (ok) {
+		uint64_t r = 0;
+		uint64_t st = scm_call_svc(1u, 0x0au, 2u, 0, 0, 0, &r);   /* BOOT_SET_REMOTE_STATE(ZAP_RESUME, 0) */
+		printf("SWEET GPU: RECOVER #%u: SCM zap resume status %#llx result %#llx\n", n,
+		    (unsigned long long)st, (unsigned long long)r);
+		rb[w++] = pkt7(102, 1);                   /* CP_SET_SECURE_MODE */
+		rb[w++] = 0;
+		rb[w++] = pkt7(98, 2);                    /* CP_WHERE_AM_I */
+		rb[w++] = (uint32_t)GVA_SHADOW;
+		rb[w++] = (uint32_t)(GVA_SHADOW >> 32);
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_RB), RB_SIZE, FALSE);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		gwr(g, 0x807, w);
+		ok = be_ring_run(g, w, 500);
+		printf("SWEET GPU: RECOVER #%u: CP_SET_SECURE_MODE(0) %s\n", n, ok ? "ran" : "FAILED");
+	}
+	be_wptr = w;
+	/* the stuck job and the ones behind it count as done */
+	*be_fence = last;
+	flush_dcache64((addr64_t)(gpumem + GPUMEM_FENCEMEM), 0x1000u, FALSE);
