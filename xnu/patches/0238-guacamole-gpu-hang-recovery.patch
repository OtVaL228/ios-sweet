+	if (!ok) {
+		be_ready = false;
+		printf("SWEET GPU: RECOVER #%u FAILED: GPU backend stopped (new GPU work is refused until reboot)\n", n);
+		return false;
+	}
+	printf("SWEET GPU: RECOVER #%u done: GPU running again, jobs %u..%u dropped\n", n, done + 1, last);
+	return true;
+}
