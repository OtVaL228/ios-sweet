+/*
+ * 0172: is layer l opaque? The flag byte rec[0x467 + l] (kern_SwapSetLayer flag bit 9) is set on the game's
+ * Metal layer only, whose alpha is not all 255 (Subway Surfers: 255:61 mid:3): read as CoreAnimation's "opaque"
+ * (alpha ignored). Boot-arg sweetfbopaqueflag=0 ignores the byte (alpha samples only).
+ */
+static bool
+sweet_fb_layer_is_opaque(const uint8_t *rec, uint32_t l, SweetSurface *s)
+{
+	if (sweet_fb_opaque_flag && rec[0x467 + l] != 0) {
+		return true;
+	}
+	return s != NULL && sweet_fb_layer_opaque(s, rec + 0x64 + 16 * l);
+}
+
+/* 0172: one CP_BLIT: a source rectangle (24.8 fixed, inclusive) scaled onto a panel rectangle [px0,px1) x [py0,py1) */
+struct sweet_fb_blit {
+	uint64_t src;
+	uint32_t sw, sh, spitch;
+	uint32_t sx0, sx1, sy0, sy1;
+	uint32_t px0, px1, py0, py1;
+};
+
+/*
+ * 0172: a layer's part [x0,x1) x [y0,y1) of the logical display (inside its rect b) as a blit: the matching part
+ * of its source rect a, the panel pixels presentScaled's rounding gives that logical part. False: empty.
+ */
+static bool
+sweet_fb_part(const AppleCLCD *fb, uint64_t src, SweetSurface *s, int32_t sx, int32_t sy, int32_t aw, int32_t ah,
+    int32_t dx, int32_t dy, int32_t w, int32_t h, int32_t x0, int32_t y0, int32_t x1, int32_t y1, struct sweet_fb_blit *o)
+{
+	if (x1 <= x0 || y1 <= y0) {
+		return false;
+	}
+	o->px0 = (uint32_t)(((uint64_t)x0 * fb->fWidth + fb->fLogicalW - 1) / fb->fLogicalW);
+	o->px1 = (uint32_t)(((uint64_t)x1 * fb->fWidth + fb->fLogicalW - 1) / fb->fLogicalW);
+	o->py0 = (uint32_t)(((uint64_t)y0 * fb->fHeight + fb->fLogicalH - 1) / fb->fLogicalH);
+	o->py1 = (uint32_t)(((uint64_t)y1 * fb->fHeight + fb->fLogicalH - 1) / fb->fLogicalH);
+	o->px1 = o->px1 > fb->fWidth ? fb->fWidth : o->px1;
+	o->py1 = o->py1 > fb->fHeight ? fb->fHeight : o->py1;
+	if (o->px1 <= o->px0 || o->py1 <= o->py0) {
+		return false;
+	}
+	o->src = src;
+	o->sw = s->width;
+	o->sh = s->height;
+	o->spitch = s->bytesPerRow;
+	/* source edges in 1/256 pixel; the end is inclusive as before ((sx + aw - 1) << 8 for the whole layer) */
+	o->sx0 = (uint32_t)(sx * 256 + (int32_t)(((int64_t)(x0 - dx) * aw * 256) / w));
+	o->sx1 = (uint32_t)(sx * 256 + (int32_t)(((int64_t)(x1 - dx) * aw * 256) / w) - 256);
+	o->sy0 = (uint32_t)(sy * 256 + (int32_t)(((int64_t)(y0 - dy) * ah * 256) / h));
+	o->sy1 = (uint32_t)(sy * 256 + (int32_t)(((int64_t)(y1 - dy) * ah * 256) / h) - 256);
+	if ((int32_t)o->sx1 < (int32_t)o->sx0) {
+		o->sx1 = o->sx0;
+	}
+	if ((int32_t)o->sy1 < (int32_t)o->sy0) {
+		o->sy1 = o->sy0;
+	}
+	return true;
+}
