+/*
+ * 0230: IOAudio2 notifications, as the HAL's receive handler parses them (research/audio/coreaudio-ioa2-client-
+ * contract.md): 24-byte Mach header, refCon (4 bytes) at 0x18, event count (4) at 0x1c, then 32-byte events from
+ * 0x20: ID (4), FourCC type (4), 24-byte payload. A real driver sends 'conf' after a configuration change (the HAL
+ * hands it back unchanged with selector 3), 'goin' after start and 'halt' after stop. 0226-0229 sent none, and the
+ * HAL looped: set format, 2 s, StopIOProcID, "CAException ... ProcessRoute: 'what'", never starting IO.
+ */
+struct sweet_audio_event {
+	uint32_t id;
+	uint32_t type;
+	uint32_t arg[6];
+};
+struct sweet_audio_msg {
+	mach_msg_header_t header;
+	uint32_t refCon;
+	uint32_t count;
+	struct sweet_audio_event event;
+};
+
+static uint32_t sweet_audio_notes_logged;
+
+void
+IOAudio2DeviceUserClient::notify(uint32_t type, uint32_t arg0)
+{
+	if (notifyPort == MACH_PORT_NULL) {
+		return;
+	}
+	struct sweet_audio_msg m;
+	bzero(&m, sizeof(m));
+	m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+	m.header.msgh_size = sizeof(m);
+	m.header.msgh_remote_port = notifyPort;
+	m.header.msgh_local_port = MACH_PORT_NULL;
+	m.header.msgh_id = 0;
+	m.refCon = notifyRef;
+	m.count = 1;
+	m.event.id = 0;
+	m.event.type = type;
+	m.event.arg[0] = arg0;
+	kern_return_t kr = mach_msg_send_from_kernel_with_options(&m.header, sizeof(m), MACH_SEND_TIMEOUT, MACH_MSG_TIMEOUT_NONE);
+	if (sweet_audio_notes_logged < 40) {
+		IOLog("SWEET AUDIO: sent '%c%c%c%c' (arg %u) -> %#x\n", (char)(type >> 24), (char)(type >> 16), (char)(type >> 8),
+		    (char)type, arg0, kr);
+		sweet_audio_notes_logged++;
+	}
+}
