-		return ENOENT;
+		return sweet_sandbox_container_expected(p, arg);
+	case 0x42:      /* set container path for audit token */
+		return sweet_sandbox_container_set(arg);
 	case 5:
 		return sweet_sandbox_extension_issue(arg);
 	case 6:
