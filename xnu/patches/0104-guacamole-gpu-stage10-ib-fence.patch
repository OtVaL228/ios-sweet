 	    gpu_stage6() && gpu_stage >= 7 && gpu_stage7() && gpu_stage >= 8 && gpu_stage8() &&
-	    gpu_stage >= 9) {
-		gpu_stage9();
+	    gpu_stage >= 9 && gpu_stage9() && gpu_stage >= 10) {
+		gpu_stage10();
 	}
