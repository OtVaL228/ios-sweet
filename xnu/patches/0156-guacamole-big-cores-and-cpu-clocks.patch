diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
new file mode 100644
index 000000000..5b2145486
--- /dev/null
+++ b/bsd/dev/sweet_cpufreq.c
@@ -0,0 +1,95 @@
+/*
+ * SWEET (guacamole, SM8150) CPU clocks: the OSM (operating state manager) of each CPU domain.
+ *
+ * Nothing here ran the CPU clocks: every core stayed at what the boot left. On SM8150 the OSM picks a domain's
+ * frequency and voltage from a table it was given by the boot; the OS asks for a row of it. Android's DT
+ * ("qcom,clk-cpu-osm"): pwrcl 0x18323000 (cpu 0-3, Cortex-A55, up to 1785.6 MHz), perfcl 0x18325800 (cpu 4-6,
+ * Cortex-A76, 2419.2 MHz), perfpcl 0x18327800 (cpu 7, 2956.8 MHz). Registers as Linux's qcom-cpufreq-hw "v1" and
+ * the downstream clk-cpu-osm.c have them: the table from 0x110 in rows of 32 bytes (FREQ: bits 31:30 clock source,
+ * 0 = the 300 MHz init rate, else 7:0 = multiple of 19.2 MHz; bits 18:16 core count), the requested row at 0x920
+ * (DCVS_PERF_STATE_DESIRED). Thermal limits stay with the hardware (LMh), as under Linux.
+ *
+ * Boot-arg sweetcpufreq: 1 (default) reads and logs the tables and the requested rows; 2 asks the A76 domains for
+ * their top row; 3 the A55 domain as well; 0 leaves the block alone.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_cpufreq_init(void);
+
+#define OSM_SIZE                0x1400u
+#define OSM_FREQ_LUT            0x110u
+#define OSM_LUT_ROW             32u
+#define OSM_LUT_ROWS            40u
+#define OSM_PERF_STATE          0x920u
+#define OSM_XO_KHZ              19200u
+
+static const struct {
+	const char *name;
+	uint64_t pa;
+	unsigned first_cpu, last_cpu;
+	bool big;
+} sweet_osm[] = {
+	{ "pwrcl (A55, cpu 0-3)", 0x18323000ull, 0, 3, false },
+	{ "perfcl (A76, cpu 4-6)", 0x18325800ull, 4, 6, true },
+	{ "perfpcl (A76, cpu 7)", 0x18327800ull, 7, 7, true },
+};
+
+static inline uint32_t
+osm_rd(vm_offset_t b, uint32_t off)
+{
+	return *(volatile uint32_t *)(b + off);
+}
+
+static inline void
+osm_wr(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(b + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	uint32_t mode = 1;
+	(void)PE_parse_boot_argn("sweetcpufreq", &mode, sizeof(mode));
+	if (mode == 0) {
+		printf("SWEET CPUFREQ: off (sweetcpufreq=0)\n");
+		return;
+	}
+	for (unsigned d = 0; d < sizeof(sweet_osm) / sizeof(sweet_osm[0]); d++) {
+		vm_offset_t b = ml_io_map(sweet_osm[d].pa, OSM_SIZE);
+		if (b == 0) {
+			continue;
+		}
+		/* the table's rows up to the first repeated one (the rest of the 40 repeat the top) */
+		uint32_t khz[OSM_LUT_ROWS], rows = 0;
+		char line[400];
+		int at = 0;
+		for (uint32_t i = 0; i < OSM_LUT_ROWS; i++) {
+			uint32_t f = osm_rd(b, OSM_FREQ_LUT + i * OSM_LUT_ROW);
+			uint32_t k = (f >> 30) == 0 ? 300000u : (f & 0xffu) * OSM_XO_KHZ;
+			if (i > 0 && k == khz[i - 1]) {
+				break;
+			}
+			khz[rows++] = k;
+			if (at < (int)sizeof(line) - 12) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %u", k / 1000);
+			}
+		}
+		line[at] = 0;
+		uint32_t cur = osm_rd(b, OSM_PERF_STATE);
+		printf("SWEET CPUFREQ: %s: %u rows (MHz)%s; requested row %u (%u MHz)\n", sweet_osm[d].name, rows, line, cur,
+		    cur < rows ? khz[cur] / 1000 : 0);
+		if (rows > 1 && ((mode >= 2 && sweet_osm[d].big) || mode >= 3)) {
+			osm_wr(b, OSM_PERF_STATE, rows - 1);
+			printf("SWEET CPUFREQ: %s: asked row %u (%u MHz), reads back %u\n", sweet_osm[d].name, rows - 1,
+			    khz[rows - 1] / 1000, osm_rd(b, OSM_PERF_STATE));
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
