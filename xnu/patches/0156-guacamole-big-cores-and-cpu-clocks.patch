index 8e2958646..856b16346 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -5009,6 +5009,72 @@ choose_next_pset(
 	return nset;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/pexpert.h>
+/*
+ * 0156: core placement on SM8150 (guacamole). This kernel runs the SMP Clutch scheduler, one pset: the ADT gives every
+ * CPU cluster-type 0 (tools/mkadt.py), there is no AMP/Edge scheduler, and choose_processor() takes the lowest idle
+ * CPU, so a woken thread lands on a Cortex-A55 (cpu 0-3, 1.79 GHz) whenever one is idle, the A76s (cpu 4-6 2.42 GHz,
+ * 7 2.96 GHz) only when all four are busy. backboardd's render thread, busy ~26 ms a frame (mtl2 run 15), was among
+ * them. Only which idle CPU is taken changes: a perf thread (realtime, or a user thread at base priority
+ * BASEPRI_USER_INITIATED and up: QoS user-initiated/interactive, foreground main threads, the render server) takes an
+ * idle A76 first, any other an idle A55 first; with none of its kind idle it takes any idle CPU, as before.
+ * The same as iOSPlus10's 0395 placement on SM8450 (akshaynexus/iOSPlus10), written for this kernel.
+ * Boot-arg sweetplace=0 keeps the old rule.
+ */
+static cpumap_t sweet_sched_pmask = 0xf0;               /* cpu 4-7 */
+static int sweet_sched_place = -1;
+
+static inline cpumap_t
+sweet_sched_big(void)
+{
+	if (sweet_sched_place < 0) {
+		int on = 1;
+		(void)PE_parse_boot_argn("sweetplace", &on, sizeof(on));
+		sweet_sched_place = on ? 1 : 0;
+	}
+	return sweet_sched_place ? sweet_sched_pmask : 0;
+}
+
+static inline bool
+sweet_thread_wants_big(thread_t thread)
+{
+	if (get_threadtask(thread) == kernel_task) {
+		return false;
+	}
+	return thread->sched_pri >= BASEPRI_RTQUEUES || thread->base_pri >= BASEPRI_USER_INITIATED;
+}
+
+/* The CPU of map this thread takes: its kind first, else any; -1 when map is empty */
+static int
+sweet_pick_cpu(thread_t thread, cpumap_t map)
+{
+	cpumap_t big = sweet_sched_big();
+	if (big == 0 || map == 0) {
+		return lsb_first(map);
+	}
+	cpumap_t pref = sweet_thread_wants_big(thread) ? (map & big) : (map & ~big);
+	return lsb_first(pref ? pref : map);
+}
+
+/* An idle hint (the thread's last CPU) of the wrong kind gives way to an idle CPU of the right kind */
+static processor_t
+sweet_check_idle_hint(processor_set_t pset, processor_t hint, thread_t thread)
+{
+	cpumap_t big = sweet_sched_big();
+	if (big == 0) {
+		return hint;
+	}
+	bool want_big = sweet_thread_wants_big(thread);
+	if (bit_test(big, hint->cpu_id) == want_big) {
+		return hint;
+	}
+	cpumap_t idle = pset->cpu_state_map[PROCESSOR_IDLE] & pset->primary_map & pset->recommended_bitmask;
+	cpumap_t pref = want_big ? (idle & big) : (idle & ~big);
+	return pref ? processor_array[lsb_first(pref)] : hint;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
