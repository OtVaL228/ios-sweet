+/*
+ * 0252: the chip set up at boot (50 s) is silent until `haptic init` sets it up again: plays run (GLB_STATE 7,
+ * DONE, no faults) but the motor does not move. Not yet understood (haptic dump, 0251, before/after will say).
+ * So the first play after boot sets the chip up again (hp.fresh), and with boot-arg sweethapticidle=S any play
+ * after S idle seconds does too (default 0: off). ~0.7 s, mostly the RAM load. Called without hp.lock.
+ */
+static void
+hap_ensure(const char *who)
+{
+	if (!hp.ready || hp.mode < 2) {
+		return;
+	}
+	bool need = !hp.fresh;
+	uint64_t now = mach_absolute_time();
+	if (!need && hp.idle_s != 0 && hp.last != 0) {
+		uint64_t idle_ns = 0;
+		absolutetime_to_nanoseconds(now - hp.last, &idle_ns);
+		need = idle_ns / NSEC_PER_SEC >= hp.idle_s;
+	}
+	if (need) {
+		printf("SWEET HAPTIC: setting the chip up again before a play (%s, %s)\n", who, hp.fresh ? "idle" : "first since boot");
+		if (hap_configure(true, false) != 0) {
+			printf("SWEET HAPTIC: set-up FAILED\n");
+		}
+	}
+	hp.last = mach_absolute_time();
+}
