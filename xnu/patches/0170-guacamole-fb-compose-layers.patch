+/*
+ * 0170: alpha of a layer's source rectangle, sampled on an 8x8 grid: how many samples are 0, 255, between.
+ * CoreAnimation's surfaces are premultiplied BGRA. An upper layer whose samples are all 0 carries no alpha
+ * at all (an opaque Metal drawable may leave it 0): it is drawn opaque, not blended away.
+ */
+static void
+sweet_fb_alpha_samples(const uint8_t *base, uint32_t bpr, int32_t sx, int32_t sy, int32_t sw, int32_t sh,
+    uint32_t *zero, uint32_t *full, uint32_t *part)
+{
+	*zero = *full = *part = 0;
+	for (int32_t j = 0; j < 8; j++) {
+		const uint32_t *row = (const uint32_t *)(base + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * bpr);
+		for (int32_t i = 0; i < 8; i++) {
+			uint32_t alpha = row[sx + (sw * (2 * i + 1)) / 16] >> 24;
+			if (alpha == 0) {
+				(*zero)++;
+			} else if (alpha == 255) {
+				(*full)++;
+			} else {
+				(*part)++;
+			}
+		}
+	}
+}
+
+/* premultiplied source-over, one channel pair at a time (a = 1..254) */
+static inline uint32_t
+sweet_fb_over(uint32_t src, uint32_t dst)
+{
+	uint32_t inv = 255u - (src >> 24);
+	uint32_t rb = (dst & 0x00ff00ffu) * inv;
+	uint32_t ag = ((dst >> 8) & 0x00ff00ffu) * inv;
+	rb = ((rb + 0x00800080u + ((rb >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+	ag = ((ag + 0x00800080u + ((ag >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+	uint32_t out = rb | (ag << 8);
+	/* add the source with per-channel saturation */
+	uint32_t sum = 0;
+	for (unsigned c = 0; c < 32; c += 8) {
+		uint32_t v = ((out >> c) & 0xffu) + ((src >> c) & 0xffu);
+		sum |= (v > 255u ? 255u : v) << c;
+	}
+	return sum;
+}
+
+static uint32_t sweet_fb_comp_logged;
+
+/*
+ * 0170: a frame of two or more layers (or one whose source and destination sizes differ), composed in the
+ * cached fCompose in layer order (the record's layer 0 lowest), then copied once into the panel memory,
+ * scaled by fColMap. False: not for this path (present() shows it).
+ */
+bool
+AppleCLCD::presentComposed(const uint8_t *rec)
+{
+	if (!sweet_fb_compose || !fScaleUp || fColMap == NULL) {
+		return false;
+	}
+	uint32_t mask = get32(rec, 0x104), layers = 0;
+	bool scaled = false;
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			layers++;
+			const uint8_t *a = rec + 0x64 + 16 * l, *b = rec + 0xc4 + 16 * l;
+			if (get32(a, 8) != 0 && get32(a, 12) != 0 && (get32(a, 8) != get32(b, 8) || get32(a, 12) != get32(b, 12))) {
+				scaled = true;
+			}
+		}
+	}
+	if (layers == 0 || (layers == 1 && !scaled)) {
+		return false;
+	}
+	if (fCompose == NULL) {
+		fCompose = (uint32_t *)IOMallocData((vm_size_t)fLogicalW * fLogicalH * 4);
+		fComposeX = (uint32_t *)IOMallocData((vm_size_t)fLogicalW * 4);
+		if (fCompose == NULL || fComposeX == NULL) {
+			IOLog("SWEET FB: no memory to compose frames: layers pasted as before\n");
+			sweet_fb_compose = false;
+			return false;
+		}
+	}
+	pauseConsole();
+	uint64_t began = mach_absolute_time();
+	bzero(fCompose, (size_t)fLogicalW * fLogicalH * 4);
+	bool log = sweet_fb_comp_logged < 12 || (sweet_fb_stats.composed == 0 && sweet_fb_comp_logged < 200);
+	if (log) {
+		sweet_fb_comp_logged++;
+	}
+	bool first = true;
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		uint32_t id = get32(rec, 0x54 + 4 * l);
+		if (!(mask & (1u << l)) || id == 0) {
+			continue;
+		}
+		const uint8_t *a = rec + 0x64 + 16 * l, *b = rec + 0xc4 + 16 * l;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t dw = (int32_t)get32(b, 8), dh = (int32_t)get32(b, 12);
+		SweetSurface *s = sweet_surface_copy(id);
+		uintptr_t src = s != NULL ? s->kernelAddress() : 0;
+		if (s != NULL && (sw <= 0 || sh <= 0)) {
+			sw = (int32_t)s->width;
+			sh = (int32_t)s->height;
+		}
+		if (dw <= 0 || dh <= 0) {
+			dw = sw;
+			dh = sh;
+		}
+		bool ok = s != NULL && s != fSurface && src != 0 && s->memory != NULL && s->elementWidth == 1 &&
+		    s->elementHeight == 1 && (s->bytesPerElement == 4 || s->bytesPerElement == 0) && sx >= 0 && sy >= 0 &&
+		    sw > 0 && sh > 0 && sx + sw <= (int32_t)s->width && sy + sh <= (int32_t)s->height &&
+		    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 <= s->memory->getLength();
+		uint32_t zero = 0, full = 0, part = 0;
+		bool blend = false;
+		if (ok) {
+			s->memory->performOperation(kIOMemoryIncoherentIOFlush, 0, s->memory->getLength());
+			const uint8_t *base = (const uint8_t *)(src + s->offset);
+			sweet_fb_alpha_samples(base, s->bytesPerRow, sx, sy, sw, sh, &zero, &full, &part);
+			blend = !first && zero != 64;
+			/* destination clipped to the logical display; each kept column/row maps back to the source */
+			int32_t x0 = dx < 0 ? 0 : dx, y0 = dy < 0 ? 0 : dy;
+			int32_t x1 = dx + dw > (int32_t)fLogicalW ? (int32_t)fLogicalW : dx + dw;
+			int32_t y1 = dy + dh > (int32_t)fLogicalH ? (int32_t)fLogicalH : dy + dh;
+			if (x1 <= x0 || y1 <= y0) {
+				x1 = x0;
+				y1 = y0;                /* off the display: nothing to draw */
+			}
+			for (int32_t x = x0; x < x1; x++) {
+				fComposeX[x] = (uint32_t)(sx + (int32_t)(((int64_t)(x - dx) * sw) / dw));
+			}
+			for (int32_t y = y0; y < y1; y++) {
+				const uint32_t *srow = (const uint32_t *)(base +
+				    (uint64_t)(sy + (int32_t)(((int64_t)(y - dy) * sh) / dh)) * s->bytesPerRow);
+				uint32_t *drow = fCompose + (uint64_t)y * fLogicalW;
+				if (!blend) {
+					if (sw == dw) {
+						memcpy(drow + x0, srow + fComposeX[x0], (size_t)(x1 - x0) * 4);
+					} else {
+						for (int32_t x = x0; x < x1; x++) {
+							drow[x] = srow[fComposeX[x]];
+						}
+					}
+					continue;
+				}
+				for (int32_t x = x0; x < x1; x++) {
+					uint32_t p = srow[fComposeX[x]];
+					uint32_t alpha = p >> 24;
+					if (alpha == 255u) {
+						drow[x] = p;
+					} else if (alpha != 0) {
+						drow[x] = sweet_fb_over(p, drow[x]);
+					}
+				}
+			}
+			if (blend) {
+				sweet_fb_stats.comp_blend++;
+			} else {
+				sweet_fb_stats.comp_opaque++;
+			}
+			first = false;
+		} else {
+			sweet_fb_stats.comp_skipped++;
+		}
+		if (log) {
+			/* per-layer flag bytes as kern_SwapSetLayer sets them (NOTES 2026-10-17), transform */
+			IOLog("SWEET FB: compose swap %u layer %u surface %u %ux%u fmt 0x%x bpe %u bpr %u a %d,%d %dx%d b %d,%d %dx%d "
+			    "xform %u flags %02x %02x %02x %02x %02x %02x alpha 0:%u 255:%u mid:%u -> %s\n",
+			    get32(rec, 0x50), l, id, s ? s->width : 0, s ? s->height : 0, s ? s->pixelFormat : 0,
+			    s ? s->bytesPerElement : 0, s ? s->bytesPerRow : 0, sx, sy, sw, sh, dx, dy, dw, dh,
+			    get32(rec, 0x114 + 4 * l), rec[0x2ca + l], rec[0x2cc + l], rec[0x2e3 + l], rec[0x2e5 + l],
+			    rec[0x2e6 + l], rec[0x467 + l], zero, full, part, !ok ? "skipped" : blend ? "blended" : "opaque");
+		}
+		OSSafeReleaseNULL(s);
+	}
+	/* a GPU blit of an earlier frame still running would land on top of this one later */
+	for (unsigned k = 0; k < 2; k++) {
+		if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+			sweet_fb_stats.comp_gpu_wait++;
+			(void)sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 50000000ull);
+		}
+	}
+	for (uint32_t py = 0; py < fHeight; py++) {
+		uint32_t ly = (uint32_t)(((uint64_t)py * fLogicalH) / fHeight);
+		const uint32_t *srow = fCompose + (uint64_t)ly * fLogicalW;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = 0; px < fWidth; px++) {
+			drow[px] = srow[fColMap[px]];
+		}
+	}
+	sweet_fb_stats.composed++;
+	sweet_fb_stats.comp_time += mach_absolute_time() - began;
+	return true;
+}
+
 void
 AppleCLCD::present(const uint8_t *rec)
 {
