 	extern void flame_wlan_init(void);
 	flame_wlan_init();       /* 0139: /dev/wlan, en0 + Apple80211 for wifid (bsd/dev/flame_wlan.c) */
+	extern void sweet_btuart_init(void);
+	sweet_btuart_init();     /* 0220: Bluetooth kernel controls for BlueTool / bluetoothd and btbridge */
