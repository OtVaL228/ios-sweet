+/*
+ * 0229: CoreAudio writes registry properties (HALB_UCObject::SetProperty -> IORegistryEntrySetCFProperties); the
+ * IOService default answers kIOReturnUnsupported, and VirtualAudio then dropped the device: "Could not add
+ * PhysicalDevice ID: 33 UID: SweetBuiltInAudio. Reason: CAException (-536870201)" (2026-11-10). Accept every key,
+ * keep it as a property of the object written to, log the first 24 writes.
+ */
+static uint32_t sweet_audio_setprops_logged;
+
+static IOReturn
+sweet_audio_set_properties(IORegistryEntry *entry, const char *what, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	while (OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject())) {
+		OSObject *value = dict->getObject(key);
+		if (sweet_audio_setprops_logged < 24) {
+			OSNumber *n = OSDynamicCast(OSNumber, value);
+			OSString *s = OSDynamicCast(OSString, value);
+			if (n != NULL) {
+				IOLog("SWEET AUDIO: %s sets %s property \"%s\" = %llu (%#llx)\n", name, what, key->getCStringNoCopy(),
+				    n->unsigned64BitValue(), n->unsigned64BitValue());
+			} else {
+				IOLog("SWEET AUDIO: %s sets %s property \"%s\" = %s\n", name, what, key->getCStringNoCopy(),
+				    s != NULL ? s->getCStringNoCopy() : value != NULL ? value->getMetaClass()->getClassName() : "null");
+			}
+			sweet_audio_setprops_logged++;
+		}
+		if (value != NULL) {
+			entry->setProperty(key, value);
+		}
+	}
+	it->release();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAudio2Device::setProperties(OSObject *properties)
+{
+	return sweet_audio_set_properties(this, "device", properties);
+}
