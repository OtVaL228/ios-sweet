diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -8,6 +8,11 @@ extern "C" {
 int sweet_spmi_init(void);
 /* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
 int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/*
+ * 0167: one byte to a PM8150B charger register (SID 2: 0x1061 FCC, 0x1342 ICL override, 0x1365 load cfg,
+ * 0x1366 ICL options, 0x1370 USB ICL; nothing else), through a write channel owned by EE0. Thread context; 0 success.
+ */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
 #ifdef __cplusplus
 }
 #endif
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -1,7 +1,10 @@
 /*
  * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
- * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
- * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * Reads through the observer channels; 0167 adds sweet_spmi_write for five
+ * PM8150B charger registers alone (input and charge current limits), through
+ * the write channel of an APID EE0 owns (shim/spmi.c's PON write: a write to
+ * another layout went to CrashDump on guac-probe v3). No interrupt clear,
+ * peripheral enable or other PMIC writes.
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
  */
@@ -17,6 +20,7 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
+#define SP_CHN_PA  0x0c600000u   /* write channels: + 0x10000 * APID (Linux spmi-pmic-arb.c, v5) */
 #define SP_NO_APID 0xffffu
 
 static vm_offset_t sp_core, sp_obs, sp_cfg;
@@ -25,6 +29,7 @@ static unsigned sp_count;
 static bool sp_attempted, sp_ready;
 /* A timed-out command may complete late: never reuse that lane this boot. */
 static bool sp_poisoned[512];
+static vm_offset_t sp_chn[512];   /* write channels mapped so far */
 
 static uint32_t
 sp_rd(vm_offset_t base, unsigned off)
@@ -91,7 +96,8 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	bool charger = peripheral >= 0x10 && peripheral <= 0x13;       /* SMB5 CHGR, DCDC, BATIF, USBIN */
 	bool allowed = sid == 0 ? charger || peripheral == 0x48 ||     /* PM6150 QG */
 	    peripheral == 0x60 :                                        /* 0133: PM8150 RTC (sweet_rtc.c) */
-	    sid == 2 && (charger || peripheral == 0x40 || peripheral == 0x41); /* 0136: PM8150B FG gen4 */
+	    sid == 2 && (charger || peripheral == 0x15 ||                /* 0167: PM8150B Type-C (Rp) */
+	    peripheral == 0x40 || peripheral == 0x41);                  /* 0136: PM8150B FG gen4 */
 	if (!sp_ready || !out || !allowed || addr > 0xffffu) {
 		return -1;
 	}
@@ -125,4 +131,48 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	static const unsigned writable[] = { 0x1061, 0x1342, 0x1365, 0x1366, 0x1370 };
+	bool allowed = false;
+	for (unsigned i = 0; i < sizeof(writable) / sizeof(writable[0]); ++i) {
+		allowed |= sid == 2 && addr == writable[i];
+	}
+	if (!sp_ready || !allowed) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET CHARGE: no EE0 write channel for sid=%u addr=%#x\n", sid, addr);
+		return -1;
+	}
+	if (!sp_chn[apid]) {
+		sp_chn[apid] = ml_io_map(SP_CHN_PA + 0x10000u * apid, 0x1000);
+	}
+	vm_offset_t ch = sp_chn[apid];
+	if (!ch) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = value;                    /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4;      /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET CHARGE: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
