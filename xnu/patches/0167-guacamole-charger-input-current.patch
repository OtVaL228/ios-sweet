+/* 0167: the attached source's input current limit (the header comment). */
+void
+SweetBattery::configureCharging(void)
+{
+	uint8_t apsdStatus, apsd, rp, icl, options, override, load, fcc, fv;
+	if (sweet_spmi_read(2, 0x1307, &apsdStatus) || !(apsdStatus & 1u) ||   /* APSD_STATUS: DTC done */
+	    sweet_spmi_read(2, 0x1308, &apsd) || sweet_spmi_read(2, 0x1506, &rp) ||
+	    sweet_spmi_read(2, 0x1370, &icl) || sweet_spmi_read(2, 0x1366, &options) ||
+	    sweet_spmi_read(2, 0x1342, &override) || sweet_spmi_read(2, 0x1365, &load) ||
+	    sweet_spmi_read(2, 0x1061, &fcc) || sweet_spmi_read(2, 0x1070, &fv)) {
+		return;
+	}
+	unsigned ma;
+	if (apsd & 0x01u) {                     /* SDP_CHARGER: a computer's port */
+		ma = 0;
+	} else if (rp & 0x02u) {                /* SNK_RP_3P0 */
+		ma = 2000;
+	} else if ((apsd & 0x0eu) || (rp & 0x04u)) { /* DCP, CDP, OCP; SNK_RP_1P5 */
+		ma = 1500;
+	} else {
+		ma = 1000;
+	}
+	bool changed = false;
+	if (ma && (icl != ma / 50u || !(options & 1u) || (override & 1u) || !(load & 0x10u))) {
+		changed = !sweet_spmi_write(2, 0x1370, (uint8_t)(ma / 50u)) &&
+		    !sweet_spmi_write(2, 0x1366, (uint8_t)(options | 1u)) &&            /* USBIN_MODE_CHG */
+		    !sweet_spmi_write(2, 0x1342, (uint8_t)(override & ~1u)) &&          /* ICL_OVERRIDE off */
+		    !sweet_spmi_write(2, 0x1365, (uint8_t)(load | 0x10u));              /* ICL_OVERRIDE_AFTER_APSD */
+	}
+	if (fcc < 2000u / 50u) {
+		changed |= !sweet_spmi_write(2, 0x1061, (uint8_t)(2000u / 50u));
+	}
+	if (changed || fChargeSeen[0] != apsd || fChargeSeen[1] != rp || fChargeSeen[2] != icl) {
+		uint8_t iclNow = icl, fccNow = fcc;
+		(void)sweet_spmi_read(2, 0x1370, &iclNow);
+		(void)sweet_spmi_read(2, 0x1061, &fccNow);
+		IOLog("SWEET CHARGE: APSD %#x Rp %#x: ICL %u -> %u mA (options %#x override %#x load %#x), "
+		    "FCC %u -> %u mA, float voltage raw %#x%s\n", apsd, rp, icl * 50u, iclNow * 50u, options,
+		    override, load, fcc * 50u, fccNow * 50u, fv, ma ? "" : " (computer port: left)");
+		fChargeSeen[0] = apsd;
+		fChargeSeen[1] = rp;
+		fChargeSeen[2] = iclNow;
+	}
+}
