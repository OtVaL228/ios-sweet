+/* bsd_init, right after the root is mounted and before launchd runs. */
+void
+sweet_mailbox_root_install(void)
+{
+	unsigned enabled = 0, root = 0;
+	(void)PE_parse_boot_argn("sweetmailbox", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetboxroot", &root, sizeof(root));
+	if (!enabled || !root) {
+		return;
+	}
+	char part[40];
+	box_part(part);
+	uint32_t nfiles = 0;
+	void *buf = box_read(part, &nfiles);
+	if (!buf) {
+		return;
+	}
+	unsigned total = 0;
+	box_root_installed = box_walk(buf, nfiles, true, &total);
+	printf("SWEET BOX: root pass, %u/%u files installed\n", box_root_installed, total);
+	kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+}
