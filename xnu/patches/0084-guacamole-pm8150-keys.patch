diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..c70f60a 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -1,6 +1,10 @@
 /*
  * Minimal polled SWEET keys. Call once after the scheduler is running.
  * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * GUACAMOLE (OnePlus 7 Pro, PM8150): power = PON KPDPWR (SID0 0x810 bit0),
+ * volume-up = PM8150 GPIO6 (SID0 periph 0xc5), volume-down = PM8150 GPIO7
+ * (periph 0xc6, gpio-keys in the live DT) OR PON RESIN (bit1, qcom,pon_2
+ * linux,code 114 in the same DT); both GPIOs are active low.
  * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
  * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
  */
@@ -21,11 +25,13 @@ void sweet_keys_init(void);
 #define KEYS_OBS_PA      0x0e600000u
 #define KEYS_CNFG_PA     0x0c40a000u
 #define KEYS_PON_RT      0x0810u
-#define KEYS_GPIO_RT     0xc110u
+#define KEYS_VUP_RT      0xc510u    /* PM8150 GPIO6 INT_RT_STS */
+#define KEYS_VDN_RT      0xc610u    /* PM8150 GPIO7 INT_RT_STS */
 #define KEYS_NO_APID     0xffffu
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
-static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_vup_apid = KEYS_NO_APID,
+    keys_vdn_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
 static int keys_sleep_chan;
@@ -98,23 +104,31 @@ keys_thread(void *arg, wait_result_t result)
 	(void)arg;
 	(void)result;
 	for (;;) {
-		uint8_t pon = 0, gpio = 0;
+		uint8_t pon = 0, vup = 0xff, vdn = 0xff;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
-		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
-		if (!pok || !gok) {
+		bool uok = keys_read(keys_vup_apid, KEYS_VUP_RT, &vup);
+		bool dok = keys_read(keys_vdn_apid, KEYS_VDN_RT, &vdn);
+		/* 0 power, 1 volume up, 2 volume down (sweet_hid_key numbering) */
+		int now[3] = {
+			pok && (pon & 1u),
+			uok && !(vup & 1u),
+			(pok && (pon & 2u)) || (dok && !(vdn & 1u)),
+		};
+		bool ok[3] = {pok, uok, pok || dok};
+		if (!pok || (keys_vup_apid != KEYS_NO_APID && !uok) ||
+		    (keys_vdn_apid != KEYS_NO_APID && !dok)) {
 			if ((errors++ % 250u) == 0) {
-				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
-				    pok, gok, keys_last_status);
+				printf("SWEET KEYS: read error pon-ok=%d vup-ok=%d vdn-ok=%d arb-status=%#x\n",
+				    pok, uok, dok, keys_last_status);
 			}
 		} else {
 			errors = 0;
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+			if (ok[k] && now[k] != state[k]) {
 				state[k] = now[k];
-				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
-				    k, state[k], pon, gpio);
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio6=%#x gpio7=%#x\n",
+				    k, state[k], pon, vup, vdn);
 				sweet_hid_key(k, state[k]);
 			}
 		}
@@ -152,24 +166,31 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x4c1, count);
-	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	keys_vup_apid = keys_find_apid(0x0c5, count);
+	keys_vdn_apid = keys_find_apid(0x0c6, count);
+	uint8_t pon = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
-	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
-	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
-	bool sok = keys_read(keys_gpio_apid, 0xc105, &subtype);
-	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
-	    keys_version, count, keys_pon_apid, keys_gpio_apid,
-	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u pon=%#x/%d gpio6-apid=%u gpio7-apid=%u\n",
+	    keys_version, count, keys_pon_apid, pon, pok, keys_vup_apid, keys_vdn_apid);
 	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
-	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
-	    mode & 3u : (mode >> 4) & 7u;
-	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
-		printf("SWEET KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
-		keys_gpio_apid = KEYS_NO_APID;
+	uint16_t *apids[2] = {&keys_vup_apid, &keys_vdn_apid};
+	for (int g = 0; g < 2; ++g) {
+		uint16_t base = (uint16_t)(0xc500u + 0x100u * (unsigned)g);
+		uint8_t st = 0, mode = 0, en = 0, subtype = 0;
+		bool rok = keys_read(*apids[g], base + 0x10u, &st);
+		bool mok = keys_read(*apids[g], base + 0x40u, &mode);
+		bool eok = keys_read(*apids[g], base + 0x46u, &en);
+		bool sok = keys_read(*apids[g], base + 0x05u, &subtype);
+		unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+		    mode & 3u : (mode >> 4) & 7u;
+		printf("SWEET KEYS: gpio%d rt=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d dir=%u\n",
+		    6 + g, st, rok, mode, mok, en, eok, subtype, sok, dir);
+		if (!rok || !eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+			printf("SWEET KEYS: gpio%d not confirmed enabled as input; withheld, PMIC unchanged\n", 6 + g);
+			*apids[g] = KEYS_NO_APID;
+		}
 	}
-	if (!pok && !gok) {
+	if (!pok && keys_vup_apid == KEYS_NO_APID && keys_vdn_apid == KEYS_NO_APID) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
 	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
