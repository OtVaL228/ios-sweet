--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -279,15 +279,55 @@
  * launchd reports mach lookups as "error = 159: Sandbox restriction"
  * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
  * "profile not found"). SWEET runs without a sandbox: operations succeed
- * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
- * use of each operation number is logged.
+ * (checks allow, profile init is accepted); container paths fail with
+ * ENOENT. The first use of each operation number is logged.
+ *
+ * Sandbox extensions are tokens a daemon issues so that a sandboxed client
+ * may reach something. tccd issues one with every grant ("Failed to issue
+ * Sandbox Extension for kTCCServicePhotos" when issuing fails), and assetsd
+ * aborts without it ("assetsd requires TCCPhotosService access": Photos
+ * never opens). libsystem_sandbox (iOS 16.7.16) passes op 5 (issue) seven
+ * u64: extension class, -, name, flags, a 2048-byte buffer for the token,
+ * pid, -; and op 6 (consume) { token, length, u64 *handle }, the handle being
+ * what sandbox_extension_consume() returns. With no sandbox to extend, any
+ * token will do: issue writes "sweet;<class>", consume accepts every token
+ * and hands out handle 1.
  */
 static uint64_t sweet_sandbox_seen;
 
 static int
-sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+sweet_sandbox_extension_issue(user_addr_t arg)
+{
+	uint64_t args[7];
+	int error = copyin(arg, args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	char class[128] = "";
+	size_t done;
+	if (args[0] != 0 && copyinstr((user_addr_t)args[0], class, sizeof(class), &done) != 0) {
+		class[0] = '\0';
+	}
+	char token[sizeof(class) + 8];
+	int len = snprintf(token, sizeof(token), "sweet;%s", class);
+	return copyout(token, (user_addr_t)args[4], (size_t)len + 1);
+}
+
+static int
+sweet_sandbox_extension_consume(user_addr_t arg)
 {
+	uint64_t args[3];               /* token, length, user address of the handle */
+	int error = copyin(arg, args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	uint64_t handle = 1;
+	return copyout(&handle, (user_addr_t)args[2], sizeof(handle));
+}
+
+static int
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
 	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
 		sweet_sandbox_seen |= 1ULL << call;
 		char name[32];
@@ -296,10 +336,12 @@
 	}
 	switch (call) {
 	case 4:         /* container path (audit token / pid) */
-	case 5:         /* extension issue */
-	case 6:         /* extension consume */
 	case 0x43:      /* container expected */
 		return ENOENT;
+	case 5:
+		return sweet_sandbox_extension_issue(arg);
+	case 6:
+		return sweet_sandbox_extension_consume(arg);
 	default:
 		return 0;
 	}
