 }
 
+/*
+ * ===== Stage 6: GX power through the GMU, first GPU register reads =====
+ *
+ * Linux v6.6, non-legacy GMU: a6xx_hfi_set_freq() (GX_BW_PERF_VOTE 30,
+ * blocking ack, perf index, bw 0), then a6xx_gmu_set_oob(GPU_SET):
+ * HOST2GMU_INTR_SET bit 30, ack GMU2HOST_INTR_INFO bit 31, cleared via
+ * GMU2HOST_INTR_CLR. The GMU then powers the GX domain and rail itself.
+ * The AHB fence (AO_AHB_FENCE_CTRL) is put in allow mode (0) first, as
+ * Linux leaves it. GPU registers: Linux a6xx.xml.h, n*4 from 0x2c00000.
+ * The OOB is left set (GX stays on); no GPU register is written.
+ */
+#define GPU_PA            0x02c00000u
+#define GPU_SIZE          0x00040000u
+
+static bool
+gpu_stage6(void)
+{
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (!gmu || !gpucc) {
+		return false;
+	}
+	printf("SWEET GPU: stage 6: GX power via GMU OOB\n");
+	printf("SWEET GPU: before: GX GDSC %#010x RPMH_POWER_STATE %#x SPTPRAC %#x AHB_FENCE %#x\n",
+	    rd(gpucc, 0x100c), rd(gmu, GMU_R(0x50ec)), rd(gmu, GMU_R(0x50d0)), rd(gmu, GMU_R(0x9310)));
+	wr(gmu, GMU_R(0x9310), 0);                        /* AO_AHB_FENCE_CTRL: allow */
+	uint32_t vote[4] = {0, 1, 1, 0};                  /* hdr, ack_type blocking, perf index 1 (257 MHz), bw 0 */
+	if (hfi_send(gmu, 30, vote, 4, NULL)) {
+		printf("SWEET GPU: GX_BW_PERF_VOTE failed\n");
+		return false;
+	}
+	gpu_checkpoint("about to ask the GMU for GX (OOB GPU_SET)");
+	wr(gmu, GMU_R(0x5194), 1u << 30);                 /* HOST2GMU_INTR_SET: OOB GPU_SET */
+	bool ack = wait_bits(gmu, GMU_R(0x5192), 1u << 31, true, 100000);
+	uint32_t info = rd(gmu, GMU_R(0x5192));
+	wr(gmu, GMU_R(0x5191), 1u << 31);                 /* GMU2HOST_INTR_CLR */
+	uint32_t gx = rd(gpucc, 0x100c);
+	printf("SWEET GPU: OOB GPU_SET %s (info %#x); GX GDSC %#010x (%s) RPMH_POWER_STATE %#x SPTPRAC %#x\n",
+	    ack ? "acked" : "TIMEOUT", info, gx, (gx & GDSC_PWR_ON) ? "on" : "off",
+	    rd(gmu, GMU_R(0x50ec)), rd(gmu, GMU_R(0x50d0)));
+	gpu_gmu_report(gmu, "oob");
+	if (!ack || !(gx & GDSC_PWR_ON)) {
+		printf("SWEET GPU: GX not powered: GPU registers not read\n");
+		return false;
+	}
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	gpu_checkpoint("GX on; about to read RBBM_STATUS");
+	printf("SWEET GPU: RBBM_STATUS %#x STATUS1 %#x INT_0_STATUS %#x\n",
+	    rd(gpu, 0x210 * 4u), rd(gpu, 0x211 * 4u), rd(gpu, 0x201 * 4u));
+	printf("SWEET GPU: CP_SQE_CNTL %#x CP_HW_FAULT %#x CP_STATUS_1 %#x CP_PROTECT_CNTL %#x GBIF_HALT %#x\n",
+	    rd(gpu, 0x808 * 4u), rd(gpu, 0x821 * 4u), rd(gpu, 0x825 * 4u), rd(gpu, 0x84f * 4u),
+	    rd(gpu, 0x3c45 * 4u));
+	printf("SWEET GPU: stage 6 done: GX powered by the GMU, GPU registers readable (OOB left set)\n");
+	return true;
+}
+
 static unsigned gpu_stage;
 
 static void
@@ -1035,8 +1096,8 @@ gpu_thread(void *arg, wait_result_t result)
 	gpu_fw_report();
 	printf("SWEET GPU: stage 1 done\n");
