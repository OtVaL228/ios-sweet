+/*
+ * 0198: the panel's own refresh. The OnePlus 7 Pro's panel runs in DSI command mode and paces itself: the display
+ * controller's INTF1 tear check (0x0ae6b800 + 0x280..) sends a frame each time the panel's TE says so (autorefresh
+ * +0x2b4 = 80000001), measured 16.706-16.712 ms = 59.84-59.86 Hz (vsyncprobe, 2026-11-09). The 60.000 Hz this
+ * driver published made CoreAnimation's own frame clock (it never asks for vsync notifications, 0154) drift one
+ * frame against the panel every ~7 s. At start the line counter (+0x2b0, 0 .. height once a frame) is read for
+ * ~100 ms: the measured period is published (IOMFBDisplayRefresh, modes) and runs the vsync timer, which also keeps
+ * its ticks at the frame's start from then on. Boot-arg sweetfblock=0: as before (60 Hz timer, nothing read).
+ */
+#define SWEET_FB_INTF1_PAGE     0x0ae6b000ull
+#define SWEET_FB_INTF1_OFF      0x800u
+#define SWEET_FB_TE_HEIGHT      0x294u          /* tear check: the frame's lines (0c30 = 3120) */
+#define SWEET_FB_TE_LINE        0x2b0u          /* line counter */
+#define SWEET_FB_TE_AUTOREFRESH 0x2b4u          /* bit 31: autorefresh on */
+static volatile uint32_t *sweet_fb_te;          /* INTF1's registers, mapped for good (NULL: not locked) */
+static uint32_t sweet_fb_te_height;
+static uint64_t sweet_fb_period_ns;             /* measured frame period (0: none) */
+
+static bool
+sweet_fb_measure_refresh(void)
+{
+	uint32_t lock = 1;
+	(void)PE_parse_boot_argn("sweetfblock", &lock, sizeof(lock));
+	if (!lock) {
+		IOLog("SWEET FB: panel refresh not measured (sweetfblock=0)\n");
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(SWEET_FB_INTF1_PAGE, 0x1000, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapInhibitCache) : NULL;
+	if (map == NULL) {
+		IOLog("SWEET FB: panel refresh: INTF1 not mapped\n");
+		OSSafeReleaseNULL(md);
+		return false;
+	}
+	volatile uint32_t *te = (volatile uint32_t *)(map->getVirtualAddress() + SWEET_FB_INTF1_OFF);
+	uint32_t height = te[SWEET_FB_TE_HEIGHT / 4] & 0xffff, autorefresh = te[SWEET_FB_TE_AUTOREFRESH / 4];
+	if (!(autorefresh & 0x80000000u) || height < 1000 || height > 4000) {
+		IOLog("SWEET FB: panel refresh: INTF1 tear check not as probed (autorefresh %08x, height %u): 60 Hz\n",
+		    autorefresh, height);
+		map->release();
+		md->release();
+		return false;
+	}
+	/* frame starts = the line counter going back down; 7 of them (~100 ms), at most 300 ms */
+	uint64_t began = mach_absolute_time(), limit, first = 0, last = 0, t;
+	nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &limit);
+	unsigned starts = 0;
+	uint32_t prev = te[SWEET_FB_TE_LINE / 4] & 0xffff;
+	while (starts < 7 && (t = mach_absolute_time()) - began < limit) {
+		uint32_t line = te[SWEET_FB_TE_LINE / 4] & 0xffff;
+		if (line + 16 < prev) {
+			if (starts++ == 0) {
+				first = t;
+			}
+			last = t;
+		}
+		prev = line;
+	}
+	uint64_t ns = 0;
+	if (starts >= 3) {
+		absolutetime_to_nanoseconds(last - first, &ns);
+		ns /= starts - 1;
+	}
+	if (ns < 8000000 || ns > 25000000) {       /* 40 - 125 Hz, or nothing */
+		IOLog("SWEET FB: panel refresh: %u frame starts in 300 ms (%llu ns each): 60 Hz\n", starts, ns);
+		map->release();
+		md->release();
+		return false;
+	}
+	sweet_fb_te = te;                       /* md and map stay for good */
+	sweet_fb_te_height = height;
+	sweet_fb_period_ns = ns;
+	IOLog("SWEET FB: panel refresh measured: %llu ns a frame = %llu.%03llu Hz (%u lines, %u frame starts)\n", ns,
+	    1000000000000ull / ns / 1000, 1000000000000ull / ns % 1000, height, starts);
+	return true;
+}
+
+/* 0198: the vsync timer's next timeout, so that it fires at the start of the panel's next frame */
+static uint32_t
+sweet_fb_next_tick_us(void)
+{
+	if (sweet_fb_te == NULL) {
+		return sweet_fb_vsync_us;
+	}
+	uint32_t line = sweet_fb_te[SWEET_FB_TE_LINE / 4] & 0xffff;
+	if (line > sweet_fb_te_height) {
+		line = sweet_fb_te_height;
+	}
+	uint64_t us = (uint64_t)sweet_fb_vsync_us * (sweet_fb_te_height - line) / sweet_fb_te_height;
+	if (us < sweet_fb_vsync_us / 4) {
+		us += sweet_fb_vsync_us;        /* nearly there: the one after (no double tick) */
+	}
+	return (uint32_t)us + 50;               /* just past the start */
+}
