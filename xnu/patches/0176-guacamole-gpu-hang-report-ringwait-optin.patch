 		be_seqno = 1;
 	}
 	uint32_t fence = be_seqno;
+	sweet_gpu_hist_note(fence, iova, dwords, n);           /* 0176 */
 	be_emit(pkt7(70, 4));
 	be_emit(0x4u | 0x80000000u);                   /* CACHE_FLUSH_TS | IRQ */
 	be_emit((uint32_t)GVA_FENCEMEM);
@@ -2483,6 +2555,7 @@ sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
 			return 0;
 		}
 		if (timeout_ns == 0 || mach_absolute_time() >= deadline) {
+			sweet_gpu_hang_check();                 /* 0176 */
 			return ETIMEDOUT;
