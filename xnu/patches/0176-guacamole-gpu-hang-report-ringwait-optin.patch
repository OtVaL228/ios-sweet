+/*
+ * 0176: who queued each recent job (fence, pid, first IB and its size, IB count), and a report when the GPU
+ * stops: the CP's position (ring and IB1/IB2 pointers, remaining dwords), RBBM/CP status and the SMMU fault
+ * registers, with the jobs around the stuck one. A hang = the done fence has not moved for 2 s while later
+ * jobs are queued. Reported once per stuck fence.
+ */
+extern int proc_selfpid(void);
+extern void proc_name(int pid, char *buf, int size);
+#define SWEET_GPU_HIST  128
+static struct {
+	uint32_t fence, pid, n, dwords;
+	uint64_t iova;
+} sweet_gpu_hist[SWEET_GPU_HIST];
+
+static void
+sweet_gpu_hist_note(uint32_t fence, const uint64_t *iova, const uint32_t *dwords, unsigned n)
+{
+	unsigned i = fence % SWEET_GPU_HIST;
+	sweet_gpu_hist[i].fence = fence;
+	sweet_gpu_hist[i].pid = (uint32_t)proc_selfpid();
+	sweet_gpu_hist[i].n = n;
+	sweet_gpu_hist[i].dwords = n ? dwords[0] : 0;
+	sweet_gpu_hist[i].iova = n ? iova[0] : 0;
+}
+
+static uint32_t sweet_gpu_hang_seen_done, sweet_gpu_hang_reported;
+static uint64_t sweet_gpu_hang_since;
+
+static void
+sweet_gpu_hang_check(void)
+{
+	if (be_fence == NULL || be_gpu == 0) {
+		return;
+	}
+	uint32_t done = *be_fence, last = be_seqno;
+	uint64_t now = mach_absolute_time();
+	if (done != sweet_gpu_hang_seen_done || done == last) {
+		sweet_gpu_hang_seen_done = done;
+		sweet_gpu_hang_since = now;
+		return;
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(now - sweet_gpu_hang_since, &ns);
+	if (ns < 2000000000ull || sweet_gpu_hang_reported == done + 1) {
+		return;
+	}
+	sweet_gpu_hang_reported = done + 1;
+	vm_offset_t g = (vm_offset_t)be_gpu;
+	printf("SWEET GPU: HANG: done %u, queued up to %u, stuck %llu ms\n", done, last, ns / 1000000ull);
+	printf("SWEET GPU: HANG: RBBM_STATUS %#x STATUS3 %#x CP rptr %#x wptr %#x HW_FAULT %#x INT %#x STATUS_1 %#x\n",
+	    grd(g, 0x210), grd(g, 0x213), grd(g, 0x806), be_wptr % RB_DWORDS, grd(g, 0x821), grd(g, 0x823), grd(g, 0x825));
+	printf("SWEET GPU: HANG: IB1 %#llx rem %#x  IB2 %#llx rem %#x\n",
+	    ((uint64_t)grd(g, 0x929) << 32) | grd(g, 0x928), grd(g, 0x92a),
+	    ((uint64_t)grd(g, 0x92c) << 32) | grd(g, 0x92b), grd(g, 0x92d));
+	redwood_gpu_report("hang");
+	for (uint32_t f = done > 3 ? done - 3 : 1; f <= done + 4 && f <= last; f++) {
+		unsigned i = f % SWEET_GPU_HIST;
+		char name[32] = "?";
+		if (sweet_gpu_hist[i].fence == f) {
+			if (sweet_gpu_hist[i].pid == 0) {
+				strlcpy(name, "kernel (display blit)", sizeof(name));
+			} else {
+				proc_name((int)sweet_gpu_hist[i].pid, name, sizeof(name));
+			}
+		}
+		printf("SWEET GPU: HANG: %s job %u: pid %u %s, %u IB(s), first %#llx (%u dwords)\n",
+		    f == done + 1 ? ">>" : "  ", f, sweet_gpu_hist[i].pid, name, sweet_gpu_hist[i].n,
+		    (unsigned long long)sweet_gpu_hist[i].iova, sweet_gpu_hist[i].dwords);
+	}
+}
+
