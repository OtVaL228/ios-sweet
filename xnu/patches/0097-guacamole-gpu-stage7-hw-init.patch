+/*
+ * ===== Stage 7: GPU-side SMMU context, GPU memory, register init (no CP start) =====
+ *
+ * Linux v6.6 a6xx_gpu.c hw_init() for the a640, up to but NOT including
+ * "gpu_write(CP_SQE_CNTL, 1)": GBIF unhalt, secure TSB off, 64-bit address
+ * mode, HWCG (a640_hwcg[], SP clock gated around it, RBBM_CLOCK_CNTL
+ * 0x8aa8aa82), GBIF QoS, UCHE ranges (GMEM 1 MiB at 0x100000), ROQ/mem
+ * pool, PC_DBG_ECO 0x00200200, UBWC (amsbc 1, hbb_lo 2), hang detection,
+ * CP protect (a6xx_protect[], 32 slots), SQE image (first dword skipped,
+ * adreno_fw_create_bo) at CP_SQE_INSTR_BASE, a 32 KiB ring at CP_RB_BASE
+ * with RB_CNTL BUFSZ 12 BLKSZ 2 NO_UPDATE (no hw APRIV on a640) and the
+ * RPTR shadow. Register numbers: a6xx.xml.h. mxtpasontop's A618 notes:
+ * an early SQE_CNTL write was not harmless; this stage never writes it.
+ * GPU traffic (DT gfx3d_user: SID 0 mask 0x401) -> exact SMRs 0x000/0x400
+ * -> CB1 (the GMU keeps CB0 for now); its tables map the buffers at GPU VA
+ * 0x01000000 (ring/SQE read-only, shadow privileged, as Linux maps them).
+ */
+#define GPU_REG(n)        ((uint32_t)(n) * 4u)
+#define GPUMEM_SIZE       0x100000u
+#define GPUMEM_SQE        0x10000u
+#define GPUMEM_RB         0x20000u
+#define GPUMEM_SHADOW     0x30000u
+#define GVA_SQE           0x01000000ull
+#define GVA_RB            0x01010000ull
+#define GVA_SHADOW        0x01020000ull
+#define RB_SIZE           0x8000u
+#define SMMU_CB1          0x9000u
+#define PTE_AP_RO         (2ull << 6)
+
+static vm_offset_t gpumem;
+static uint64_t gpumem_pa;
+
