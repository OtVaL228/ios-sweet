+
 #define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
 #define gicd_write32(offset, data) (_gic_write32(gicd_base + (offset), (data)))
 #define gicr_read32(offset) (_gic_read32(gicr_pe_base + (offset)))
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(SWEET)
+/* Enable the SM8150 SDE aggregate SPI after its device-side status is clear. */
+bool
+sweet_gic_enable_irq(uint32_t intid)
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020) {
+		return false;
+	}
+	uint32_t bank = intid / 32;
+	uint32_t bit = 1U << (intid % 32);
+	uint32_t group_off = 0x080 + bank * 4;
+	gicd_write32(group_off, gicd_read32(group_off) | bit); /* IGROUPR: Group 1 NS */
+	uint32_t priority_off = 0x400 + (intid / 4) * 4;
+	uint32_t priority_shift = (intid % 4) * 8;
+	uint32_t priority = gicd_read32(priority_off);
+	priority = (priority & ~(0xFFU << priority_shift)) | (0xA0U << priority_shift);
+	gicd_write32(priority_off, priority); /* IPRIORITYR */
+	_gic_write64(gicd_base + 0x6000 + (uint64_t)intid * 8,
+	    __builtin_arm_rsr64("MPIDR_EL1") & 0xFF00FFFFFFULL); /* IROUTER */
+	gicd_write32(0x100 + bank * 4, bit); /* ISENABLER */
+	__builtin_arm_dsb(0xf);
+	__builtin_arm_isb(0xf);
+	return true;
+}
+#endif
