+void
+AppleCLCD::handleHardwareVsyncIrq(void)
+{
+	fSdeIrqDispatches++;
+	if (!fHardwareVsync || fSde == 0) {
+		return;
+	}
+	volatile uint32_t *status = (volatile uint32_t *)(fSde + SWEET_SDE_INTF1 + SWEET_SDE_INTF_INTR_STATUS);
+	volatile uint32_t *tearStatus = (volatile uint32_t *)(fSde + SWEET_SDE_INTF1_TEAR_IRQ + SWEET_SDE_TEAR_INTR_STATUS);
+	uint32_t pending = *status & SWEET_SDE_INTF1_VSYNC;
+	uint32_t tearPending = *tearStatus & SWEET_SDE_TEAR_TE_DETECTED;
+	if (pending == 0 && tearPending == 0) {
+		return;
+	}
+	if (pending != 0) {
+		*((volatile uint32_t *)(fSde + SWEET_SDE_INTF1 + SWEET_SDE_INTF_INTR_CLEAR)) = pending;
+	}
+	if (tearPending != 0) {
+		*((volatile uint32_t *)(fSde + SWEET_SDE_INTF1_TEAR_IRQ + SWEET_SDE_TEAR_INTR_CLEAR)) = tearPending;
+	}
+	__builtin_arm_dsb(0xf);
+	fLastHwVsync = mach_absolute_time();
+	fHwVsyncIrqs++;
+	thread_call_enter(fHwVsyncCall);
+}
