+/* 0173: of 64 samples of the layer's source rectangle (rows cache-invalidated), how many are black (RGB sum <= 24) */
+static uint32_t
+sweet_fb_layer_black(SweetSurface *s, const uint8_t *a)
+{
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	uintptr_t src = s->kernelAddress();
+	if (sw <= 0 || sh <= 0) {
+		sw = (int32_t)s->width;
+		sh = (int32_t)s->height;
+	}
+	if (src == 0 || s->memory == NULL || s->bytesPerElement != 4 || sx < 0 || sy < 0 || sx + sw > (int32_t)s->width ||
+	    sy + sh > (int32_t)s->height ||
+	    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 > s->memory->getLength()) {
+		return 0;
+	}
+	uint32_t black = 0;
+	for (int32_t j = 0; j < 8; j++) {
+		uint64_t off = (uint64_t)s->offset + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * s->bytesPerRow + (uint64_t)sx * 4;
+		s->memory->performOperation(kIOMemoryIncoherentIOFlush, off, (uint64_t)sw * 4);
+		const uint32_t *row = (const uint32_t *)(src + off);
+		for (int32_t i = 0; i < 8; i++) {
+			uint32_t p = row[(sw * (2 * i + 1)) / 16];
+			if (((p >> 16) & 0xff) + ((p >> 8) & 0xff) + (p & 0xff) <= 24) {
+				black++;
+			}
+		}
+	}
+	return black;
+}
+
+static uint32_t sweet_fb_black_logged;
