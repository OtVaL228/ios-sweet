+/*
+ * 0251: what the chip did with a play, 5 and 25 ms after GO: SYSST (01) / SYSINT (02), bits (aw8697_reg.h)
+ * 7 BSTERR boost error, 6 OV, 5 UVL under-voltage, 4 FF_AE, 3 FF_AF, 2 OCD over-current, 1 OT over-temperature,
+ * 0 DONE; GLB_STATE (46, low nibble 0 = standby / idle) and SYSCTRL (04). A play that never leaves state 0, or
+ * that sets BSTERR / UVL / OCD / OT, is what a silent motor looks like.
+ */
+static void
+hap_report(const char *what)
+{
+	uint8_t s1 = 0, i1 = 0, g1 = 0, c1 = 0, g2 = 0, i2 = 0;
+	hap_wait(5);
+	(void)hap_read(0x01, &s1);
+	(void)hap_read(R_SYSINT, &i1);
+	(void)hap_read(R_GLBSTATE, &g1);
+	(void)hap_read(R_SYSCTRL, &c1);
+	hap_wait(20);
+	(void)hap_read(R_GLBSTATE, &g2);
+	(void)hap_read(R_SYSINT, &i2);
+	printf("SWEET HAPTIC: %s: +5ms sysst %#x sysint %#x glb %#x sysctrl %#x, +25ms glb %#x sysint %#x\n", what, s1, i1, g1,
+	    c1, g2, i2);
+}
