+/*
+ * One layer, logical rect (dx,dy,w,h) <- surface rect (sx,sy), drawn on a
+ * panel bigger than the logical display: every panel pixel takes the
+ * logical pixel it falls in (nearest neighbour). Pixels go directly
+ * from the (cached) surface into the panel, so the
+ * write-combined panel memory is never read back.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	uintptr_t src = s->kernelAddress();
+	uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL || sx < 0 || sy < 0) {
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	/* clip in logical space: to the surface and to the logical display */
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	/* panel range covered: first panel pixel whose logical coord >= d,
+	 * up to the first whose logical coord >= d + w */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	if (px1 > fWidth) {
+		px1 = fWidth;
+	}
+	if (py1 > fHeight) {
+		py1 = fHeight;
+	}
+	const uintptr_t base = src + s->offset + (uint64_t)sx * 4;
+	for (uint32_t py = py0; py < py1; py++) {
+		uint32_t ly = (uint32_t)(((uint64_t)py * fLogicalH) / fHeight);
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + (int32_t)ly - dy) * s->bytesPerRow);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			drow[px] = srow[fColMap[px] - (uint32_t)dx];
+		}
+	}
+}
