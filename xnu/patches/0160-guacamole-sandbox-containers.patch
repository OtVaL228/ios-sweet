@@ -292,9 +295,132 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  * what sandbox_extension_consume() returns. With no sandbox to extend, any
  * token will do: issue writes "sweet;<class>", consume accepts every token
  * and hands out handle 1.
+ *
+ * Containers: launchd gives a process it spawns into a container (app
+ * extensions, through RunningBoard) Sandbox spawn attributes,
+ * posix_spawnattr_setmacpolicyinfo_np("Sandbox") of libsystem_sandbox's
+ * sandbox_spawnattrs (u32 version 0, u32 size 0x450, u32 profile name
+ * length, u32 container length, char profile[64] at 0x10, char container
+ * [1024] at 0x50). Sandbox.kext keeps the container and answers op 4
+ * (sandbox_container_path_for_pid / _for_audit_token: { pid, pid version,
+ * buffer, length, by token }) with it. PlugInKit asks that in every plugin
+ * ("Bootstrapping; failed to get my own sandbox container") and stops the
+ * plugin when it fails: the Files app's LocalStorage provider never ran.
+ * sweet_sandbox_exec below keeps the path per pid; op 4 hands it out,
+ * ENOENT for a process without one.
  */
 static uint64_t sweet_sandbox_seen;
 
+#define SWEET_SB_ATTR_SIZE      0x450
+#define SWEET_SB_ATTR_CONTAINER 0x50
+#define SWEET_SB_CONTAINERS     64
+
+static struct {
+	pid_t pid;
+	char  path[SWEET_SB_ATTR_SIZE - SWEET_SB_ATTR_CONTAINER];
+} sweet_sb_containers[SWEET_SB_CONTAINERS];
+static unsigned sweet_sb_container_next;
+static LCK_GRP_DECLARE(sweet_sb_lck_grp, "sweet_sandbox");
+static LCK_MTX_DECLARE(sweet_sb_lock, &sweet_sb_lck_grp);
+
+/* Forget pid's container; with path, remember that one (the oldest slot goes). */
+static void
+sweet_sb_container_set(pid_t pid, const char *path)
+{
+	lck_mtx_lock(&sweet_sb_lock);
+	int slot = -1;
+	for (int i = 0; i < SWEET_SB_CONTAINERS; i++) {
+		if (sweet_sb_containers[i].pid == pid) {
+			sweet_sb_containers[i].pid = 0;
+			slot = i;
+		}
+	}
+	if (path != NULL) {
+		if (slot < 0) {
+			slot = (int)(sweet_sb_container_next++ % SWEET_SB_CONTAINERS);
+		}
+		sweet_sb_containers[slot].pid = pid;
+		strlcpy(sweet_sb_containers[slot].path, path, sizeof(sweet_sb_containers[slot].path));
+	}
+	lck_mtx_unlock(&sweet_sb_lock);
+}
+
+/*
+ * Called by exec_mach_imgact (kern_exec.c) for every image, before set[ug]id
+ * handling: imgp still has the environment. pkd puts the plugin's data
+ * container in the launch overlay as HOME (and CFFIXED_USER_HOME, TMPDIR)
+ * while launchd's SandboxContainer stays empty (seen for the LocalStorage
+ * provider: profile "plugin", container length 0), so a process spawned with
+ * a Sandbox profile but no container gets its HOME when that is a container.
+ */
+void sweet_sandbox_exec(struct proc *p, struct image_params *imgp);
+
+#define SWEET_SB_CONTAINERS_DIR "/private/var/mobile/Containers/"
+
+void
+sweet_sandbox_exec(struct proc *p, struct image_params *imgp)
+{
+	size_t attrlen = 0;
+	const char *a = exec_spawnattr_getmacpolicyinfo(&imgp->ip_px_smpx, "Sandbox", &attrlen);
+	const char *container = NULL, *from = "spawn attributes";
+	if (a != NULL && attrlen >= SWEET_SB_ATTR_SIZE) {
+		uint32_t size, len;
+		memcpy(&size, a + 4, sizeof(size));
+		memcpy(&len, a + 0xc, sizeof(len));
+		if (size == SWEET_SB_ATTR_SIZE && len > 0 && len < SWEET_SB_ATTR_SIZE - SWEET_SB_ATTR_CONTAINER &&
+		    a[SWEET_SB_ATTR_CONTAINER + len] == '\0') {
+			container = a + SWEET_SB_ATTR_CONTAINER;
+		}
+		for (const char *e = imgp->ip_endargv; container == NULL && e < imgp->ip_endenvv; e += strlen(e) + 1) {
+			if (strncmp(e, "HOME=" SWEET_SB_CONTAINERS_DIR, 5 + strlen(SWEET_SB_CONTAINERS_DIR)) == 0) {
+				container = e + 5;
+				from = "HOME";
+			}
+		}
+	}
+	sweet_sb_container_set(proc_pid(p), container);
+	if (container != NULL) {
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s[%d] container %s (%s)\n", name, proc_pid(p), container, from);
+	}
+}
+
+static void
+sweet_sandbox_proc_exit(struct proc *p)
+{
+	sweet_sb_container_set(proc_pid(p), NULL);
+}
+
+static int
+sweet_sandbox_container_path(struct proc *p, user_addr_t arg)
+{
+	uint64_t args[5];               /* pid, pid version, buffer, length, by audit token */
+	int error = copyin(arg, args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	pid_t pid = args[0] != 0 ? (pid_t)args[0] : proc_pid(p);
+	char path[sizeof(sweet_sb_containers[0].path)];
+	path[0] = '\0';
+	lck_mtx_lock(&sweet_sb_lock);
+	for (int i = 0; i < SWEET_SB_CONTAINERS; i++) {
+		if (sweet_sb_containers[i].pid == pid) {
+			strlcpy(path, sweet_sb_containers[i].path, sizeof(path));
+			break;
+		}
+	}
+	lck_mtx_unlock(&sweet_sb_lock);
+	if (path[0] == '\0') {
+		return ENOENT;
+	}
+	size_t len = strlen(path) + 1;
+	if (len > args[3]) {
+		return ERANGE;
+	}
+	return copyout(path, (user_addr_t)args[2], len);
+}
