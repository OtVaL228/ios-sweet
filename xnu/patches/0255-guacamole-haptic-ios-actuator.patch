+/*
+ * 0255: the motor for iOS's haptics as waveforms. The audio plug-in HakiosAudio.driver (userland/audio, from
+ * ios-apollo / hakios-apollo) gives mediaserverd an "Actuator" device, the Taptic Engine of an iPhone X; iOS (VibeSynth,
+ * Core Haptics, UIKit level 2, system sounds) plays its haptics on it as 48 kHz int16 mono, and the plug-in writes them
+ * to /dev/apollo-haptic or /dev/hakios-haptic. Made here as /dev/hakios-haptic (0666). The service is ios-apollo's
+ * (xnu 0146 sweet_haptic.c's serve(), from hakios-apollo's hakios.apollo_haptic.c, APSL 2.0) for the same AW8697,
+ * on this driver's functions and OnePlus's RAM waveforms (research/haptics/README.md):
+ *   a waveform of iOS's after a pause is a tap, once its first SETTLE_US say how strong: waveform 20 (heavy) from
+ *   two thirds of full scale, 5 from a third, else 2; one that goes on past TAP_US, the looped buzz (waveform 10)
+ *   until iOS stops, at most HAPTIC_MAX_MS; the gain (DATDBG) follows its strength. At most HAPTIC_MAX_MS of driving
+ *   in any DUTY_WINDOW_MS, then a rest as long. iOS plays on the Actuator only with MobileGestalt
+ *   DeviceSupportsClosedLoopHaptics true (ADT /product/haptics, tools/mkadt.py --guacamole).
+ * Boot-arg sweethapticios=0 leaves /dev/hakios-haptic out.
+ */
+#define HI_ACTIVE_US            30000
+#define HI_SILENT_BELOW         256
+#define HI_TAP_US               60000
+#define HI_SETTLE_US            8000
+#define HI_FOLLOW_US            20000
+#define HI_MAX_MS               1000
+#define HI_WINDOW_MS            2000
+#define HI_SLOT_MS              100
+#define HI_SLOTS                (HI_WINDOW_MS / HI_SLOT_MS + 1)
+#define HI_GAIN_TOP             0x80    /* Android's strongest (aw8697_haptic_effect_strength) */
+#define HI_TOLD                 24
+#define R_DATDBG                0x39
+
+static volatile uint64_t hi_heard_us, hi_quiet_us, hi_onset_us;
+static volatile uint32_t hi_peak;
+static unsigned hi_taps, hi_loops, hi_capped;
+
+static uint64_t
+hi_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+static int
+hi_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+			peak = v > peak ? v : peak;
+		}
+		uint64_t now = hi_now_us();
+		if (peak > HI_SILENT_BELOW) {
+			if (hi_heard_us == 0 || hi_quiet_us > hi_heard_us || now - hi_heard_us >= HI_ACTIVE_US) {
+				hi_onset_us = now;
+				hi_peak = 0;
+			}
+			hi_heard_us = now;
+			if (peak > hi_peak) {
+				hi_peak = peak;
+			}
+		} else {
+			hi_quiet_us = now;
+		}
+	}
+	return error;
+}
+
+static int
+hi_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw hi_cdevsw = {
+	.d_open = hi_open, .d_close = hi_open, .d_read = eno_rdwrt, .d_write = hi_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static uint8_t
+hi_gain(uint32_t peak)
+{
+	uint32_t top = HI_GAIN_TOP, low = top * 5 / 8, third = 32767 / 3;
+	return (uint8_t)(peak >= third ? top : low + (top - low) * peak / third);
+}
+
+/* hp.lock held */
+static int
+hi_start(uint8_t wave, bool forever, uint8_t gain)
+{
+	int err = hap_play(wave, forever ? 15 : 0);
+	return err ? err : hap_write(R_DATDBG, gain);
+}
+
+static void
+hi_thread(__unused void *arg, __unused wait_result_t result)
+{
+	enum { IDLE, TAP, LOOP, REST } state = IDLE;
+	uint64_t since = 0, rest_until = 0, tap_onset = 0, followed = 0;
+	uint8_t playing_gain = 0;
+	uint32_t driven[HI_SLOTS] = { 0 };
+	uint64_t duty_slot = hi_now_us() / (HI_SLOT_MS * 1000), duty_last = hi_now_us();
+	int major = cdevsw_add(-1, &hi_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		printf("SWEET HAPTIC: /dev/hakios-haptic cannot be made\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	printf("SWEET HAPTIC: /dev/hakios-haptic: the motor plays iOS's Actuator (HakiosAudio.driver)\n");
+	for (;;) {
+		uint64_t now = hi_now_us(), slot = now / (HI_SLOT_MS * 1000), window = 0;
+		bool active = hi_heard_us != 0 && now - hi_heard_us < HI_ACTIVE_US;
+		uint32_t peak = hi_peak;
+		uint8_t gain = hi_gain(peak);
+		int err = 0;
+
+		for (uint64_t s = duty_slot + 1; s <= slot && s <= duty_slot + HI_SLOTS; s++) {
+			driven[s % HI_SLOTS] = 0;
+		}
+		duty_slot = slot;
+		if (state == TAP || state == LOOP) {
+			uint64_t spent = now - duty_last;
+			driven[slot % HI_SLOTS] += spent > HI_WINDOW_MS * 1000ull ? HI_WINDOW_MS * 1000u : (uint32_t)spent;
+		}
+		duty_last = now;
+		for (unsigned i = 0; i < HI_SLOTS; i++) {
+			window += driven[i];
+		}
+		if ((state == TAP || state == LOOP) && window >= HI_MAX_MS * 1000ull) {
+			lck_mtx_lock(hp.lock);
+			(void)hap_stop();
+			lck_mtx_unlock(hp.lock);
+			hi_capped++;
+			rest_until = now + HI_MAX_MS * 1000ull;
+			state = REST;
+			printf("SWEET HAPTIC: ios: %llu ms of driving in %u ms: stopped, rests %u ms\n", window / 1000, HI_WINDOW_MS,
+			    HI_MAX_MS);
+			hap_wait(4);
+			continue;
+		}
+		switch (state) {
+		case IDLE:
+		case TAP:
+			if (active && hi_onset_us != tap_onset && now - hi_onset_us >= HI_SETTLE_US) {
+				uint64_t began = hi_onset_us;
+				tap_onset = began;
+				if (window >= HI_MAX_MS * 1000ull || !hp.ready) {
+					break;
+				}
+				uint8_t wave = peak >= 32767u * 2 / 3 ? 20 : peak >= 32767u / 3 ? 5 : 2;
+				hap_ensure("ios");
+				lck_mtx_lock(hp.lock);
+				err = hi_start(wave, false, gain ? gain : 1);
+				lck_mtx_unlock(hp.lock);
+				if (err) {
+					break;
+				}
+				state = TAP;
+				since = now;
+				if (++hi_taps + hi_loops <= HI_TOLD) {
+					printf("SWEET HAPTIC: ios: tap %u: peak %u of 32768 -> waveform %u gain %#x\n", hi_taps, peak, wave,
+					    gain);
+				}
+				break;
+			}
+			if (state == IDLE) {
+				break;
+			}
+			if (active && hi_quiet_us < tap_onset && now - since > HI_TAP_US) {
+				lck_mtx_lock(hp.lock);
+				err = hi_start(10, true, gain ? gain : 1);
+				lck_mtx_unlock(hp.lock);
+				if (!err) {
+					state = LOOP;
+					since = followed = now;
+					playing_gain = gain ? gain : 1;
+					hi_peak = 0;
+					if (hi_taps + ++hi_loops <= HI_TOLD) {
+						printf("SWEET HAPTIC: ios: vibration %u: peak %u -> waveform 10 looped, gain %#x\n", hi_loops,
+						    peak, playing_gain);
+					}
+				}
+			} else if (!active && now - since > HI_TAP_US) {
+				lck_mtx_lock(hp.lock);
+				(void)hap_stop();
+				lck_mtx_unlock(hp.lock);
+				state = IDLE;
+			}
+			break;
+		case LOOP:
+			if (active && now - followed >= HI_FOLLOW_US) {
+				followed = now;
+				hi_peak = 0;
+				if (peak != 0 && (gain > playing_gain + 8 || gain + 8 < playing_gain)) {
+					lck_mtx_lock(hp.lock);
+					(void)hap_write(R_DATDBG, gain);
+					lck_mtx_unlock(hp.lock);
+					playing_gain = gain;
+				}
+			}
+			if (!active || now - since > HI_MAX_MS * 1000ull) {
+				bool cut = now - since > HI_MAX_MS * 1000ull;
+				if (cut) {
+					hi_capped++;
+					rest_until = now + HI_MAX_MS * 1000ull;
+				}
+				lck_mtx_lock(hp.lock);
+				(void)hap_stop();
+				lck_mtx_unlock(hp.lock);
+				state = rest_until > now ? REST : IDLE;
+			}
+			break;
+		case REST:
+			if (now >= rest_until) {
+				state = IDLE;
+			}
+			break;
+		}
+		hap_wait(4);
+	}
+}
+
+static void
+hi_start_service(void)
+{
+	uint32_t on = 1;
+	thread_t t;
+	(void)PE_parse_boot_argn("sweethapticios", &on, sizeof(on));
+	if (on && kernel_thread_start(hi_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
 static void
 hap_thread(void *arg, wait_result_t result)
 {
@@ -628,6 +872,9 @@
 		hp.ready = true;
 		hp.fresh = false;                               /* 0252: set up again at the first play */
 	}
+	if (hp.ready) {
+		hi_start_service();                             /* 0255: /dev/hakios-haptic */
+	}
 out:
 	thread_terminate(current_thread());
 }
